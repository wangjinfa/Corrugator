<?xml version="1.0" encoding="utf-8"?>
<prism:PrismApplication x:Class="Corrugator.Client.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/">
    <Application.Resources>
        <!-- ============ 配色（对齐 IPS 现场界面） ============ -->
        <SolidColorBrush x:Key="NavBgBrush" Color="#1A6FD0" />
        <SolidColorBrush x:Key="NavActiveBrush" Color="#0F56A0" />
        <SolidColorBrush x:Key="NavTextBrush" Color="#E6F0FA" />
        <SolidColorBrush x:Key="PageBgBrush" Color="#DCE1E7" />
        <SolidColorBrush x:Key="AccentBrush" Color="#1A6FD0" />
        <SolidColorBrush x:Key="AccentLightBrush" Color="#2E86C8" />
        <SolidColorBrush x:Key="TableHeaderBrush" Color="#1A6FD0" />
        <SolidColorBrush x:Key="RowNavyBrush" Color="#1B4E7E" />
        <SolidColorBrush x:Key="RowOrangeBrush" Color="#F2811E" />
        <SolidColorBrush x:Key="RowYellowBrush" Color="#FFDD7B" />
        <SolidColorBrush x:Key="BorderBrush" Color="#C6CDD6" />
        <SolidColorBrush x:Key="MutedBrush" Color="#7A8796" />
        <SolidColorBrush x:Key="WarnBrush" Color="#E74C3C" />
        <!-- 兼容原有页面 -->
        <SolidColorBrush x:Key="BrushPrimary" Color="#132136" />
        <SolidColorBrush x:Key="BrushAccent" Color="#1A6FD0" />
        <SolidColorBrush x:Key="BrushSurface" Color="#DCE1E7" />
        <SolidColorBrush x:Key="BrushBorder" Color="#C6CDD6" />

        <!-- ============ 全局字体 ============ -->
        <!-- 注意：这里不要设 Foreground，否则隐式样式会压过按钮的白色继承，导致深蓝底按钮文字发黑 -->
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <!-- ============ 顶栏导航页签 ============ -->
        <Style x:Key="NavTabItem" TargetType="TabItem">
            <Setter Property="Width" Value="132" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="Transparent">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="White" />
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource NavActiveBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="Transparent" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2E86C8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ 内容区卡片 ============ -->
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="2" />
        </Style>

        <Style x:Key="CaptionText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="11.5" />
        </Style>

        <Style x:Key="MetricText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#1E2A38" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#1E2A38" />
        </Style>

        <!-- 机台示意图上的参数块 -->
        <Style x:Key="ChipText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style x:Key="ChipBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="7,3" />
            <Setter Property="MinWidth" Value="42" />
        </Style>

        <Style x:Key="ChipLightBorder" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#9FB0C2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="7,3" />
        </Style>

        <!-- ============ 按钮 ============ -->
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="13,5" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="2">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.88" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="#1B2C46" />
            <Setter Property="Foreground" Value="#E8EEF5" />
            <Setter Property="BorderBrush" Value="#3C5473" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="12.5" />
        </Style>

        <!-- ============ 表格（深蓝表头） ============ -->
        <Style TargetType="DataGrid">
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Background" Value="White" />
            <Setter Property="RowBackground" Value="White" />
            <Setter Property="AlternatingRowBackground" Value="#F7F9FC" />
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="VerticalGridLinesBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="ColumnHeaderHeight" Value="34" />
            <Setter Property="RowHeight" Value="30" />
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{StaticResource TableHeaderBrush}" />
                        <Setter Property="Foreground" Value="White" />
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                        <Setter Property="BorderThickness" Value="0,0,1,0" />
                        <Setter Property="BorderBrush" Value="#3582D8" />
                        <Setter Property="Padding" Value="4,6" />
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="CellStyle">
                <Setter.Value>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Padding" Value="4,2" />
                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#CFE0F0" />
                                <Setter Property="Foreground" Value="#1E2A38" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    
    <!-- 基础信息页：左侧竖排菜单按钮（深蓝底白字，同现场 IPS） -->
    <Style x:Key="BasicMenuButton" TargetType="ListBoxItem">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bg" Background="#1A6FD0" CornerRadius="3" Height="30"
                            Margin="10,0,10,9" BorderBrush="Transparent" BorderThickness="1">
                        <TextBlock x:Name="Txt" Text="{Binding Text}" Foreground="White" FontSize="11.5"
                                   FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#3582D8" />
                        </Trigger>
                        <!-- 选中态：白底 + 蓝边 + 蓝字（同现场） -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#FFFFFF" />
                            <Setter TargetName="Bg" Property="BorderBrush" Value="#1A6FD0" />
                            <Setter TargetName="Txt" Property="Foreground" Value="#1A6FD0" />
                        </Trigger>
                        <!-- 分组标题：灰条 + 左对齐，不可选 -->
                        <DataTrigger Binding="{Binding IsGroup}" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#E7EBF0" />
                            <Setter TargetName="Bg" Property="BorderBrush" Value="#D6DCE3" />
                            <Setter TargetName="Bg" Property="BorderThickness" Value="0,0,0,1" />
                            <Setter TargetName="Bg" Property="CornerRadius" Value="0" />
                            <Setter TargetName="Bg" Property="Height" Value="30" />
                            <Setter TargetName="Bg" Property="Margin" Value="0" />
                            <Setter TargetName="Txt" Property="Foreground" Value="#39434E" />
                            <Setter TargetName="Txt" Property="FontWeight" Value="Normal" />
                            <Setter TargetName="Txt" Property="HorizontalAlignment" Value="Left" />
                            <Setter TargetName="Txt" Property="Margin" Value="12,0,0,0" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</Application.Resources>
</prism:PrismApplication>
