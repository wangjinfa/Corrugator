<UserControl x:Class="Corrugator.Client.Wpf.Views.CommView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="TabRadio" TargetType="RadioButton">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="#5A6675" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,2" />
                            <Border x:Name="Underline" Height="2" VerticalAlignment="Bottom" Background="Transparent" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#1A6FD0" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="#1A6FD0" />
                                <Setter Property="FontWeight" Value="Bold" />
                                <Setter TargetName="Underline" Property="Background" Value="#1A6FD0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CommButton" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="#1A6FD0" CornerRadius="2">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#3582D8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部页签 -->
        <Border Grid.Row="0" BorderBrush="#D8DDE4" BorderThickness="0,0,0,1" Background="White" Padding="12,0,0,0">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="TabConfig" Content="通讯配置设置" Style="{StaticResource TabRadio}"
                             GroupName="CommTabs" IsChecked="True" Click="OnTabConfig" Margin="0,0,4,0" />
                <RadioButton x:Name="TabDevice" Content="通讯设备设置" Style="{StaticResource TabRadio}"
                             GroupName="CommTabs" Click="OnTabDevice" Margin="0,0,4,0" />
                <RadioButton x:Name="TabPoint" Content="通讯点位变量设置" Style="{StaticResource TabRadio}"
                             GroupName="CommTabs" Click="OnTabPoint" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="12,8,12,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 查询条 -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8" Visibility="{Binding ConfigTabVisibility}">
                <TextBlock Text="配置名称:" FontSize="11.5" Foreground="#3A4653" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox Width="200" Height="26" FontSize="12" Padding="5,2" VerticalContentAlignment="Center"
                         Text="{Binding ConfigQueryName, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="参数编码:" FontSize="11.5" Foreground="#3A4653" VerticalAlignment="Center" Margin="12,0,6,0" />
                <ComboBox Width="200" Height="26" FontSize="12" IsEditable="True"
                          Text="{Binding ParCodeFilter, UpdateSourceTrigger=PropertyChanged}"
                          ItemsSource="{Binding ParCodes}" />
                <CheckBox Content="显示全部" FontSize="11.5" VerticalAlignment="Center" Margin="12,0,0,0"
                          IsChecked="{Binding ShowAll}" />
                <Button Content="🔍 搜索" Style="{StaticResource CommButton}" Margin="14,0,0,0" Click="OnSearch" />
                <Button Content="↻ 重置" Style="{StaticResource CommButton}" Margin="8,0,0,0" Click="OnReset" />
                <Button Content="＋ 新增通讯设置" Style="{StaticResource CommButton}" Margin="8,0,0,0" MinWidth="132" Click="OnAdd" />
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="10,0,0,0" />
            </StackPanel>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8" Visibility="{Binding DeviceTabVisibility}">
                <TextBlock Text="配置名称:" FontSize="11.5" Foreground="#3A4653" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox Width="200" Height="26" FontSize="12" Padding="5,2" VerticalContentAlignment="Center"
                         Text="{Binding DeviceQueryName, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="通讯类型:" FontSize="11.5" Foreground="#3A4653" VerticalAlignment="Center" Margin="12,0,6,0" />
                <ComboBox Width="160" Height="26" FontSize="12" IsEditable="True"
                          ItemsSource="{Binding DeviceTypes}"
                          Text="{Binding DeviceTypeFilter, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="通讯配置:" FontSize="11.5" Foreground="#3A4653" VerticalAlignment="Center" Margin="12,0,6,0" />
                <ComboBox Width="160" Height="26" FontSize="12" IsEditable="True"
                          ItemsSource="{Binding ConfigOptions}" DisplayMemberPath="Name"
                          SelectedValuePath="Name"
                          SelectedValue="{Binding DeviceConfigFilter, Mode=TwoWay}" />
                <CheckBox Content="显示全部" FontSize="11.5" VerticalAlignment="Center" Margin="12,0,0,0"
                          IsChecked="{Binding ShowAll}" />
                <Button Content="🔍 搜索" Style="{StaticResource CommButton}" Margin="14,0,0,0" Click="OnSearchDevice" />
                <Button Content="↻ 重置" Style="{StaticResource CommButton}" Margin="8,0,0,0" Click="OnResetDevice" />
                <Button Content="＋ 新增通讯设备" Style="{StaticResource CommButton}" Margin="8,0,0,0" MinWidth="132" Click="OnAddDevice" />
            </StackPanel>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8" Visibility="{Binding PointTabVisibility}">
                <TextBlock Text="部位:" FontSize="11.5" Foreground="#3A4653" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox Width="150" Height="26" FontSize="12" IsEditable="True"
                          ItemsSource="{Binding PointOptions.Positions}"
                          Text="{Binding PointPositionFilter, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="所属设备:" FontSize="11.5" Foreground="#3A4653" VerticalAlignment="Center" Margin="12,0,6,0" />
                <ComboBox Width="150" Height="26" FontSize="12" IsEditable="True"
                          ItemsSource="{Binding PointOptions.Devices}"
                          Text="{Binding PointDeviceFilter, UpdateSourceTrigger=PropertyChanged}" />
                <CheckBox Content="显示全部" FontSize="11.5" VerticalAlignment="Center" Margin="12,0,0,0"
                          IsChecked="{Binding ShowAll}" />
                <Button Content="🔍 搜索" Style="{StaticResource CommButton}" Margin="14,0,0,0" Click="OnSearchPoint" />
                <Button Content="↻ 重置" Style="{StaticResource CommButton}" Margin="8,0,0,0" Click="OnResetPoint" />
                <Button Content="＋ 新增点位变量" Style="{StaticResource CommButton}" Margin="8,0,0,0" MinWidth="132" Click="OnAddPoint" />
            </StackPanel>

            <!-- 配置表 -->
            <Border Grid.Row="1" BorderBrush="#D8DDE4" BorderThickness="1" Background="White"
                    Visibility="{Binding ConfigTabVisibility}">
                <DataGrid ItemsSource="{Binding Configs}" SelectedItem="{Binding SelectedConfig}"
                          AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0"
                          HeadersVisibility="Column" CanUserAddRows="False" GridLinesVisibility="None"
                          RowHeight="34" RowBackground="White" AlternatingRowBackground="#F7F9FB">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Foreground" Value="#2F3B48" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#1A6FD0" />
                                    <Setter Property="Foreground" Value="White" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Padding" Value="6,0" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Foreground" Value="White" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="34">
                            <DataGridTemplateColumn.Header>
                                <TextBlock Text="▦" FontSize="12" Foreground="#6B7785" />
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                              IsChecked="{Binding IsChecked, Mode=TwoWay}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="操作" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="修改" Style="{StaticResource GridLinkButton}" Click="OnEdit" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="配置编码" Binding="{Binding Code}" Width="120" />
                        <DataGridTextColumn Header="配置名称" Binding="{Binding Name}" Width="160" />
                        <DataGridTextColumn Header="参数说明" Binding="{Binding Desc}" Width="150" />
                        <DataGridTextColumn Header="参数编码" Binding="{Binding ParCode}" Width="140" />
                        <DataGridTextColumn Header="参数值" Binding="{Binding ParValue}" Width="*" />
                        <DataGridTemplateColumn Header="是否删除" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                              IsChecked="{Binding IsDelete, Mode=OneWay}" IsHitTestVisible="False" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- 设备表 -->
            <Border Grid.Row="1" BorderBrush="#D8DDE4" BorderThickness="1" Background="White"
                    Visibility="{Binding DeviceTabVisibility}">
                <DataGrid ItemsSource="{Binding Devices}" AutoGenerateColumns="False" IsReadOnly="True"
                          BorderThickness="0" HeadersVisibility="Column" CanUserAddRows="False"
                          GridLinesVisibility="None" RowHeight="34" RowBackground="White"
                          AlternatingRowBackground="#F7F9FB">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Foreground" Value="#2F3B48" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#1A6FD0" />
                                    <Setter Property="Foreground" Value="White" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Padding" Value="6,0" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Foreground" Value="White" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="34">
                            <DataGridTemplateColumn.Header>
                                <TextBlock Text="▦" FontSize="12" Foreground="#6B7785" />
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                              IsChecked="{Binding IsChecked, Mode=TwoWay}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="操作" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="修改" Style="{StaticResource GridLinkButton}" Click="OnEditDevice" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="设备编码" Binding="{Binding Code}" Width="110" />
                        <DataGridTextColumn Header="设备名称" Binding="{Binding Name}" Width="180" />
                        <DataGridTextColumn Header="通讯类型" Binding="{Binding CommType}" Width="170" />
                        <DataGridTextColumn Header="通讯配置" Binding="{Binding ConfigName}" Width="170" />
                        <DataGridTemplateColumn Header="启用" Width="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                              IsChecked="{Binding IsUse, Mode=OneWay}" IsHitTestVisible="False" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="删除" Width="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                              IsChecked="{Binding IsDelete, Mode=OneWay}" IsHitTestVisible="False" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- 点位表 -->
            <Border Grid.Row="1" BorderBrush="#D8DDE4" BorderThickness="1" Background="White"
                    Visibility="{Binding PointTabVisibility}">
                <DataGrid ItemsSource="{Binding Points}" AutoGenerateColumns="False" IsReadOnly="True"
                          BorderThickness="0" HeadersVisibility="Column" CanUserAddRows="False"
                          GridLinesVisibility="None" RowHeight="34" RowBackground="White"
                          AlternatingRowBackground="#F7F9FB">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Foreground" Value="#2F3B48" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#1A6FD0" />
                                    <Setter Property="Foreground" Value="White" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Padding" Value="6,0" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Foreground" Value="White" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="34">
                            <DataGridTemplateColumn.Header>
                                <TextBlock Text="▦" FontSize="12" Foreground="#6B7785" />
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                              IsChecked="{Binding IsChecked, Mode=TwoWay}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="操作" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="修改" Style="{StaticResource GridLinkButton}" Click="OnEditPoint" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="部位" Binding="{Binding Position}" Width="90" />
                        <DataGridTextColumn Header="当前值" Binding="{Binding CurValue}" Width="90" />
                        <DataGridTextColumn Header="变量编码" Binding="{Binding Code}" Width="230" />
                        <DataGridTextColumn Header="变量名称" Binding="{Binding Name}" Width="220" />
                        <DataGridTextColumn Header="变量说明" Binding="{Binding Desc}" Width="240" />
                        <DataGridTextColumn Header="所属设备" Binding="{Binding DriverCode}" Width="100" />
                        <DataGridTextColumn Header="PLC地址/MDI变量名" Binding="{Binding VarAddress}" Width="140" />
                        <DataGridTextColumn Header="数据类型" Binding="{Binding DataType}" Width="90" />
                        <DataGridTextColumn Header="可读可写" Binding="{Binding RW}" Width="100" />
                        <DataGridTextColumn Header="读取间隔" Binding="{Binding Interval}" Width="80" />
                        <DataGridTemplateColumn Header="启用" Width="60">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                              IsChecked="{Binding IsUse, Mode=OneWay}" IsHitTestVisible="False" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="是否删除" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                              IsChecked="{Binding IsDelete, Mode=OneWay}" IsHitTestVisible="False" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- 底部按钮 -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding ConfigTabVisibility}">
                <Button Content="删除" Style="{StaticResource CommButton}" Width="96" Click="OnDeleteChecked" />
                <Button Content="刷新" Style="{StaticResource CommButton}" Width="96" Margin="8,0,0,0" Click="OnRefresh" />
                <Button Content="立即生效" Style="{StaticResource CommButton}" Width="120" Margin="8,0,0,0" Click="OnReload" />
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding DeviceTabVisibility}">
                <Button Content="删除" Style="{StaticResource CommButton}" Width="96" Click="OnDeleteCheckedDevice" />
                <Button Content="刷新" Style="{StaticResource CommButton}" Width="96" Margin="8,0,0,0" Click="OnRefreshDevice" />
                <Button Content="立即生效" Style="{StaticResource CommButton}" Width="120" Margin="8,0,0,0" Click="OnReload" />
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding PointTabVisibility}">
                <Button Content="删除" Style="{StaticResource CommButton}" Width="96" Click="OnDeleteCheckedPoint" />
                <Button Content="刷新" Style="{StaticResource CommButton}" Width="96" Margin="8,0,0,0" Click="OnRefreshPoint" />
                <Button Content="立即生效" Style="{StaticResource CommButton}" Width="120" Margin="8,0,0,0" Click="OnReload" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
