<Window x:Class="Corrugator.Client.Wpf.Views.TeamEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="班组资料设置" Width="660" Height="450" WindowStartupLocation="CenterOwner"
        Background="White" ShowInTaskbar="False" ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
            <RowDefinition Height="52" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="#DCE1E7" BorderThickness="0,0,0,1">
            <Grid Margin="16,0,12,0">
                <TextBlock x:Name="TitleText" Text="班组资料设置-修改" FontSize="13" Foreground="#22303E"
                           FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button Content="✕" FontSize="13" Foreground="#7A8794" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Width="30" Height="28" BorderThickness="0"
                        Background="Transparent" Cursor="Hand" Click="OnCancelClick" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="26,18,26,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="28" />
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="34" />
                <RowDefinition Height="34" />
                <RowDefinition Height="34" />
                <RowDefinition Height="34" />
                <RowDefinition Height="34" />
                <RowDefinition Height="34" />
                <RowDefinition Height="34" />
                <RowDefinition Height="34" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="班次号:" FontSize="11.5" HorizontalAlignment="Right" VerticalAlignment="Center"
                       Margin="0,0,8,0" Foreground="#3A4653" />
            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                <TextBlock Text="*" Foreground="#C0392B" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,2,0" />
                <TextBox Width="150" Height="24" FontSize="12" VerticalContentAlignment="Center" Padding="5,0"
                         Text="{Binding Row.ShiftNo, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <TextBlock Grid.Row="0" Grid.Column="3" Text="班组名称:" FontSize="11.5" HorizontalAlignment="Right"
                       VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#3A4653" />
            <StackPanel Grid.Row="0" Grid.Column="4" Orientation="Horizontal">
                <TextBlock Text="*" Foreground="#C0392B" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,2,0" />
                <TextBox Width="220" Height="24" FontSize="12" VerticalContentAlignment="Center" Padding="5,0"
                         Text="{Binding Row.TeamName, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <TextBlock Grid.Row="1" Text="班长:" FontSize="11.5" HorizontalAlignment="Right" VerticalAlignment="Center"
                       Margin="0,0,8,0" Foreground="#3A4653" />
            <TextBox Grid.Row="1" Grid.Column="1" Width="150" Height="24" HorizontalAlignment="Left" FontSize="12"
                     VerticalContentAlignment="Center" Padding="5,0"
                     Text="{Binding Row.Leader, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="1" Grid.Column="3" Text="开始时间:" FontSize="11.5" HorizontalAlignment="Right"
                       VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#3A4653" />
            <StackPanel Grid.Row="1" Grid.Column="4" Orientation="Horizontal">
                <TextBlock Text="*" Foreground="#C0392B" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,2,0" />
                <TextBox Width="220" Height="24" FontSize="12" VerticalContentAlignment="Center" Padding="5,0"
                         Text="{Binding Row.StartTime, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <TextBlock Grid.Row="2" Text="结束时间:" FontSize="11.5" HorizontalAlignment="Right" VerticalAlignment="Center"
                       Margin="0,0,8,0" Foreground="#3A4653" />
            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                <TextBlock Text="*" Foreground="#C0392B" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,2,0" />
                <TextBox Width="150" Height="24" FontSize="12" VerticalContentAlignment="Center" Padding="5,0"
                         Text="{Binding Row.EndTime, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <TextBlock Grid.Row="2" Grid.Column="3" Text="抱车工1:" FontSize="11.5" HorizontalAlignment="Right"
                       VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#3A4653" />
            <TextBox Grid.Row="2" Grid.Column="4" Width="220" Height="24" HorizontalAlignment="Left" FontSize="12"
                     VerticalContentAlignment="Center" Padding="5,0"
                     Text="{Binding Row.Forklift1, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="3" Text="抱车工2:" FontSize="11.5" HorizontalAlignment="Right" VerticalAlignment="Center"
                       Margin="0,0,8,0" Foreground="#3A4653" />
            <TextBox Grid.Row="3" Grid.Column="1" Width="150" Height="24" HorizontalAlignment="Left" FontSize="12"
                     VerticalContentAlignment="Center" Padding="5,0"
                     Text="{Binding Row.Forklift2, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="3" Grid.Column="3" Text="创建人:" FontSize="11.5" HorizontalAlignment="Right"
                       VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#3A4653" />
            <TextBox Grid.Row="3" Grid.Column="4" Width="220" Height="24" HorizontalAlignment="Left" FontSize="12"
                     VerticalContentAlignment="Center" Padding="5,0" IsReadOnly="True" Background="#F5F6F8"
                     Text="{Binding Row.Creator}" />

            <TextBlock Grid.Row="4" Text="创建时间:" FontSize="11.5" HorizontalAlignment="Right" VerticalAlignment="Center"
                       Margin="0,0,8,0" Foreground="#3A4653" />
            <TextBox Grid.Row="4" Grid.Column="1" Width="150" Height="24" HorizontalAlignment="Left" FontSize="12"
                     VerticalContentAlignment="Center" Padding="5,0" IsReadOnly="True" Background="#F5F6F8"
                     Text="{Binding Row.CreateTime}" />

            <TextBlock Grid.Row="4" Grid.Column="3" Text="修改人:" FontSize="11.5" HorizontalAlignment="Right"
                       VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#3A4653" />
            <TextBox Grid.Row="4" Grid.Column="4" Width="220" Height="24" HorizontalAlignment="Left" FontSize="12"
                     VerticalContentAlignment="Center" Padding="5,0" IsReadOnly="True" Background="#F5F6F8"
                     Text="{Binding Row.Editor}" />

            <TextBlock Grid.Row="5" Text="修改时间:" FontSize="11.5" HorizontalAlignment="Right" VerticalAlignment="Center"
                       Margin="0,0,8,0" Foreground="#3A4653" />
            <TextBox Grid.Row="5" Grid.Column="1" Width="150" Height="24" HorizontalAlignment="Left" FontSize="12"
                     VerticalContentAlignment="Center" Padding="5,0" IsReadOnly="True" Background="#F5F6F8"
                     Text="{Binding Row.EditTime}" />
        </Grid>

        <Border Grid.Row="2" BorderBrush="#E2E7ED" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,22,0">
                <Button Content="取消" Width="86" Height="28" FontSize="12" Click="OnCancelClick" />
                <Button Content="确定" Width="86" Height="28" FontSize="12" Foreground="White" Margin="12,0,0,0"
                        Background="#1A6FD0" BorderThickness="0" Cursor="Hand" Click="OnOkClick" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
