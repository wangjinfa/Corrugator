<UserControl x:Class="Corrugator.Client.Wpf.Views.PaperInfoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="QBtn" TargetType="Button">
            <Setter Property="Height" Value="27" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="#1A6FD0" CornerRadius="3">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#3582D8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1662BB" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OpLink" TargetType="Button">
            <Setter Property="Foreground" Value="#1A6FD0" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="2,1">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=IsSelected}" Value="True">
                    <Setter Property="Foreground" Value="#D9E8FF" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DelLink" TargetType="Button" BasedOn="{StaticResource OpLink}">
            <Setter Property="Foreground" Value="#C0392B" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=IsSelected}" Value="True">
                    <Setter Property="Foreground" Value="#FFB4A8" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="#F2F4F7">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="#D8DDE4" BorderThickness="1"
                Margin="8,6,8,0" Padding="10,6">
            <StackPanel>
                <TextBlock Text="查询条件" Foreground="#1A6FD0" FontSize="11.5" FontWeight="Bold" Margin="0,0,0,6" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="原纸代号（区分大小写）:" FontSize="11.5" Foreground="#3A4653"
                               VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox Width="200" Height="26" FontSize="12" Padding="5,2" VerticalContentAlignment="Center"
                             Text="{Binding QueryCode, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Content="搜索" Style="{StaticResource QBtn}" Margin="10,0,0,0" Click="OnSearchClick" />
                    <Button Content="重置" Style="{StaticResource QBtn}" Margin="8,0,0,0" Click="OnResetClick" />
                    <Button Content="＋ 新增原纸" Style="{StaticResource QBtn}" Margin="8,0,0,0" Click="OnAddClick" />
                    <TextBlock Text="{Binding StatusMessage}" FontSize="11.5" Foreground="#5A6675"
                               VerticalAlignment="Center" Margin="12,0,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="White" Margin="8,6,8,8" BorderBrush="#E2E7ED" BorderThickness="1">
            <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True"
                      BorderThickness="0" HeadersVisibility="Column" CanUserAddRows="False"
                      GridLinesVisibility="None" RowHeight="34" RowBackground="White"
                      AlternatingRowBackground="#F7F9FB" SelectionMode="Single">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Height" Value="32" />
                        <Setter Property="Background" Value="#F2F4F7" />
                        <Setter Property="Foreground" Value="#4A5663" />
                        <Setter Property="FontSize" Value="11.5" />
                        <Setter Property="FontWeight" Value="Normal" />
                        <Setter Property="BorderBrush" Value="#E2E7ED" />
                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                        <Setter Property="Padding" Value="6,0" />
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Padding" Value="6,0" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="序号" Binding="{Binding RowNo}" Width="55" />
                    <DataGridTemplateColumn Header="操作" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="修改" Style="{StaticResource OpLink}" Click="OnEditRowClick" />
                                    <Button Content="删除" Style="{StaticResource DelLink}" Margin="10,0,0,0" Click="OnDeleteRowClick" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="原纸代号" Binding="{Binding Code}" Width="110">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Bold" />
                                <Setter Property="Foreground" Value="#2F3B48" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="克重(gsm)" Binding="{Binding GramWeight}" Width="100" />
                    <DataGridTextColumn Header="门幅(mm)" Binding="{Binding PaperWidth}" Width="100" />
                    <DataGridTextColumn Header="品牌" Binding="{Binding Brand}" Width="150" />
                    <DataGridTextColumn Header="LS2残卷" Binding="{Binding RemainLS2}" Width="100" />
                    <DataGridTextColumn Header="MS3残卷" Binding="{Binding RemainMS3}" Width="100" />
                    <DataGridTextColumn Header="LS3残卷" Binding="{Binding RemainLS3}" Width="100" />
                    <DataGridTemplateColumn Header="详情" Width="70">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="详情" Style="{StaticResource OpLink}" Click="OnDetailClick" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="" Binding="{Binding Code}" Width="*" Visibility="Hidden" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
