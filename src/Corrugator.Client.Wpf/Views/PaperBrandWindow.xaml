<Window x:Class="Corrugator.Client.Wpf.Views.PaperBrandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="原纸品牌信息修改" Width="1400" Height="860" WindowStartupLocation="CenterOwner"
        Background="White" ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition Height="*" />
            <RowDefinition Height="56" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="#DCE1E7" BorderThickness="0,0,0,1">
            <Grid Margin="16,0,12,0">
                <TextBlock x:Name="TitleText" Text="原纸品牌信息修改" FontSize="13" Foreground="#22303E"
                           FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button Content="✕" FontSize="13" Foreground="#7A8794" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Width="30" Height="28" BorderThickness="0"
                        Background="Transparent" Cursor="Hand" Click="OnCloseClick" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="14,10,14,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 供应商参数表 -->
            <Border Grid.Row="0" Background="White" BorderBrush="#E2E7ED" BorderThickness="1">
                <StackPanel>
                    <DataGrid x:Name="SupplierGrid" ItemsSource="{Binding Suppliers}" AutoGenerateColumns="False"
                              IsReadOnly="False" BorderThickness="0" HeadersVisibility="Column"
                              CanUserAddRows="True" GridLinesVisibility="None" RowHeight="32"
                              RowBackground="White" AlternatingRowBackground="#F7F9FB" SelectionUnit="Cell">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Height" Value="34" />
                                <Setter Property="Background" Value="#F2F4F7" />
                                <Setter Property="Foreground" Value="#4A5663" />
                                <Setter Property="FontSize" Value="11.5" />
                                <Setter Property="BorderBrush" Value="#E2E7ED" />
                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                                <Setter Property="Padding" Value="6,0" />
                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Padding" Value="6,0" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter Property="FontWeight" Value="Bold" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="BorderBrush" Value="#E7EAEE" />
                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                                <Setter Property="Foreground" Value="#2F3B48" />
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#0E3A6B" />
                                        <Setter Property="Foreground" Value="White" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="⠿" Width="46">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="供应商" Binding="{Binding Supplier, UpdateSourceTrigger=LostFocus}" Width="120" />
                            <DataGridTextColumn Header="额定接纸机张力" Binding="{Binding RatedTension, UpdateSourceTrigger=LostFocus}" Width="120" />
                            <DataGridTextColumn Header="蒸汽克重(gsm)" Binding="{Binding SteamGsm, UpdateSourceTrigger=LostFocus}" Width="115" />
                            <DataGridTextColumn Header="胶水克重(gsm)" Binding="{Binding GlueGsm, UpdateSourceTrigger=LostFocus}" Width="115" />
                            <DataGridTextColumn Header="包角克重(gsm)" Binding="{Binding WrapGsm, UpdateSourceTrigger=LostFocus}" Width="115" />
                            <DataGridTextColumn Header="LS0额定张力(daN)" Binding="{Binding TensionLS0, UpdateSourceTrigger=LostFocus}" Width="125" />
                            <DataGridTextColumn Header="MS1额定张力(daN)" Binding="{Binding TensionMS1, UpdateSourceTrigger=LostFocus}" Width="125" />
                            <DataGridTextColumn Header="LS1额定张力(daN)" Binding="{Binding TensionLS1, UpdateSourceTrigger=LostFocus}" Width="125" />
                            <DataGridTextColumn Header="MS2额定张力(daN)" Binding="{Binding TensionMS2, UpdateSourceTrigger=LostFocus}" Width="125" />
                            <DataGridTextColumn Header="LS2额定张力(daN)" Binding="{Binding TensionLS2, UpdateSourceTrigger=LostFocus}" Width="125" />
                            <DataGridTextColumn Header="MS3额定张力(daN)" Binding="{Binding TensionMS3, UpdateSourceTrigger=LostFocus}" Width="125" />
                            <DataGridTextColumn Header="LS3额定张力(daN)" Binding="{Binding TensionLS3, UpdateSourceTrigger=LostFocus}" Width="*" MinWidth="125" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Height="150" Background="#F0F1F2" BorderBrush="#E2E7ED" BorderThickness="0,1,0,0" />
                </StackPanel>
            </Border>

            <!-- 胶水值标题（小标签样式，同现场） -->
            <Grid Grid.Row="1" Margin="0,10,0,8">
                <Border Background="#B8D4E8" Height="24" Width="78" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                    <TextBlock Text="胶水值" FontSize="11.5" Foreground="#1F3346"
                               VerticalAlignment="Center" HorizontalAlignment="Center" />
                </Border>
                <Rectangle Height="1" Fill="#E2E7ED" VerticalAlignment="Bottom" Margin="0,0,0,11" />
            </Grid>

            <!-- 胶水值：单面机 / 双面机 -->
            <Grid Grid.Row="2" Background="White">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="370" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#F0F1F2" BorderBrush="#E2E7ED" BorderThickness="1"
                        Height="340" VerticalAlignment="Top">
                    <StackPanel>
                        <Border Background="#F0F1F2" Height="36">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="⠿" FontSize="13" Foreground="#1A6FD0" Margin="0,0,8,0" />
                                <TextBlock Text="单面机" FontSize="12.5" Foreground="#3A4653" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <DataGrid ItemsSource="{Binding SingleFaceGlues}" Background="Transparent" AutoGenerateColumns="False"
                                  BorderThickness="0" HeadersVisibility="None" CanUserAddRows="False"
                                  GridLinesVisibility="None" RowHeight="30" RowBackground="White">
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Padding" Value="6,0" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                </Style>
                            </DataGrid.CellStyle>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Background" Value="White" />
                                    <Setter Property="BorderBrush" Value="#E7EAEE" />
                                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                                    <Setter Property="Foreground" Value="#2F3B48" />
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="楞型" Binding="{Binding FluteType}" IsReadOnly="True" Width="140">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="Bold" />
                                            <Setter Property="Foreground" Value="#24476B" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="值" Binding="{Binding GlueValue, UpdateSourceTrigger=LostFocus}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="#F0F1F2" BorderBrush="#E2E7ED" BorderThickness="1"
                        Height="340" VerticalAlignment="Top">
                    <StackPanel>
                        <Border Background="#F0F1F2" Height="36">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="⠿" FontSize="13" Foreground="#1A6FD0" Margin="0,0,8,0" />
                                <TextBlock Text="双面机" FontSize="12.5" Foreground="#3A4653" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <DataGrid ItemsSource="{Binding DoubleFaceGlues}" Background="Transparent" AutoGenerateColumns="False"
                                  BorderThickness="0" HeadersVisibility="None" CanUserAddRows="False"
                                  GridLinesVisibility="None" RowHeight="30" RowBackground="White">
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Padding" Value="6,0" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                </Style>
                            </DataGrid.CellStyle>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Background" Value="White" />
                                    <Setter Property="BorderBrush" Value="#E7EAEE" />
                                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                                    <Setter Property="Foreground" Value="#2F3B48" />
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="楞型" Binding="{Binding FluteType}" IsReadOnly="True" Width="100">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="Bold" />
                                            <Setter Property="Foreground" Value="#24476B" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="层" Binding="{Binding Layer}" IsReadOnly="True" Width="80" />
                                <DataGridTextColumn Header="值" Binding="{Binding GlueValue, UpdateSourceTrigger=LostFocus}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2" BorderBrush="#E2E7ED" BorderThickness="0,1,0,0">
            <Grid Margin="0,0,16,0">
                <TextBlock Text="{Binding StatusText}" FontSize="11.5" Foreground="#5A6675"
                           VerticalAlignment="Center" HorizontalAlignment="Left" Margin="16,0,0,0" />
                <Button Content="关闭" Width="90" Height="30" FontSize="12" Foreground="White"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Background="#1A6FD0"
                        BorderThickness="0" Cursor="Hand" Click="OnCloseClick" />
            </Grid>
        </Border>
    </Grid>
</Window>
