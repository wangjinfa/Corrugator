<Window x:Class="Corrugator.Client.Wpf.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Corrugator.Client.Wpf.Converters"
        Title="登录 - 瓦楞纸板生产线生管系统"
        Width="1200" Height="440"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="True"
        Background="White" UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Window.Resources>
        <!-- 输入框外框 -->
        <Style x:Key="InputFrame" TargetType="Border">
            <Setter Property="Height" Value="42" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#DCE2EA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="2" />
        </Style>

        <Style x:Key="FlatInput" TargetType="TextBox">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#2B3440" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="CaretBrush" Value="#1A6FD0" />
        </Style>

        <Style x:Key="FlatPassword" TargetType="PasswordBox">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#2B3440" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="CaretBrush" Value="#1A6FD0" />
            <Setter Property="PasswordChar" Value="●" />
        </Style>

        <!-- 方形复选框 -->
        <Style x:Key="SquareCheck" TargetType="CheckBox">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="#4C5866" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Box" Width="14" Height="14" CornerRadius="2"
                                    Background="White" BorderBrush="#B9C4D0" BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Path x:Name="Tick" Data="M2.6,7 L5.6,10 L11.4,3.6"
                                      Stroke="White" StrokeThickness="1.8" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#1A6FD0" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="#1A6FD0" />
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#1A6FD0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 登录按钮 -->
        <Style x:Key="LoginButton" TargetType="Button">
            <Setter Property="Height" Value="42" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="#1A6FD0" CornerRadius="2">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1662BB" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#104F97" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Background" Value="#A9C6E6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconFont" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="Foreground" Value="#97A4B2" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Border BorderBrush="#2A6ED0" BorderThickness="1.5" Background="White"
            MouseLeftButtonDown="OnDragWindow">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="408" />
            </Grid.ColumnDefinitions>

            <!-- ============ 左：设备实景 ============ -->
            <Grid Grid.Column="0" ClipToBounds="True">
                <Image Source="pack://application:,,,/Assets/login-bg.jpg" Stretch="UniformToFill" />

                <!-- 向右侧白色面板渐隐 -->
                <Border>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#00FFFFFF" Offset="0.45" />
                            <GradientStop Color="#B0FFFFFF" Offset="0.82" />
                            <GradientStop Color="#FFFFFFFF" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- 左下角品牌 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                            Margin="34,0,0,30">
                    <Grid Width="46" Height="46">
                        <Ellipse Fill="#FFFFFF" Opacity="0.95" />
                        <Ellipse Width="38" Height="38" Fill="#1B3A6B" />
                        <TextBlock Text="IPS" Foreground="White" FontSize="12.5" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock Text="瓦楞纸板生产线生管系统" Foreground="White" FontSize="13.5" FontWeight="SemiBold">
                            <TextBlock.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="0" Color="#66000000" />
                            </TextBlock.Effect>
                        </TextBlock>
                        <TextBlock Text="C O R R U G A T O R   L I N E   S U I T E"
                                   Foreground="#B9CDE2" FontSize="8.5" Margin="0,5,0,0">
                            <TextBlock.Effect>
                                <DropShadowEffect BlurRadius="5" ShadowDepth="0" Color="#66000000" />
                            </TextBlock.Effect>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- ============ 右：登录面板 ============ -->
            <Grid Grid.Column="1" Background="White">
                <Button x:Name="CloseButton" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                        Width="26" Height="26" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,8,10,0" Background="Transparent" BorderThickness="0"
                        Foreground="#8A97A5" Cursor="Hand" Click="OnCloseClick" ToolTip="关闭" />

                <StackPanel Margin="46,58,44,0">
                    <TextBlock Text="智联革新" FontSize="21" Foreground="#6E7C8A" FontWeight="SemiBold" />
                    <TextBlock Text="Intelligent  Connection,  Thorough  Production"
                               FontSize="10.5" Foreground="#A6B1BE" Margin="0,7,0,0" />

                    <!-- 账号 -->
                    <Border Style="{StaticResource InputFrame}" Margin="0,44,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="30" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#xE77B;" Style="{StaticResource IconFont}" FontSize="15" />
                            <TextBox Grid.Column="1" Style="{StaticResource FlatInput}"
                                     Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="50" />
                            <TextBlock Grid.Column="2" Text="&#xE70D;" Style="{StaticResource IconFont}" FontSize="10"
                                       IsHitTestVisible="False" />
                        </Grid>
                    </Border>

                    <!-- 密码 -->
                    <Border Style="{StaticResource InputFrame}" Margin="0,14,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="30" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#xE72E;" Style="{StaticResource IconFont}" FontSize="14" />
                            <PasswordBox Grid.Column="1" x:Name="PasswordInput" Style="{StaticResource FlatPassword}"
                                         PasswordChanged="OnPasswordChanged" MaxLength="64" />
                        </Grid>
                    </Border>

                    <!-- 选项 -->
                    <StackPanel Orientation="Horizontal" Margin="2,16,0,0">
                        <CheckBox Content="保存密码" Style="{StaticResource SquareCheck}"
                                  IsChecked="{Binding SavePassword, Mode=TwoWay}" />
                        <CheckBox Content="自动登录" Style="{StaticResource SquareCheck}" Margin="34,0,0,0"
                                  IsChecked="{Binding AutoLogin, Mode=TwoWay}" />
                    </StackPanel>

                    <!-- 错误提示 -->
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#D64545" FontSize="11.5"
                               TextWrapping="Wrap" Margin="2,10,0,0" MinHeight="16" />

                    <!-- 登录按钮 -->
                    <Button x:Name="LoginButton" Content="登  录" Style="{StaticResource LoginButton}"
                            Margin="0,8,0,0" IsDefault="True" Click="OnLoginClick"
                            IsEnabled="{Binding IsBusy, Converter={x:Static conv:BooleanNegationConverter.Instance}}" />
                </StackPanel>

                <TextBlock Text="{Binding ApiDisplay}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                           Margin="0,0,20,14" FontSize="10" Foreground="#C2CBD5" />
            </Grid>
        </Grid>
    </Border>
</Window>
