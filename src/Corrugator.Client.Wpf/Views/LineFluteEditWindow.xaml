<Window x:Class="Corrugator.Client.Wpf.Views.LineFluteEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="产线楞型-修改" Width="1180" Height="700" WindowStartupLocation="CenterOwner"
        Background="White" ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
            <RowDefinition Height="56" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="#DCE1E7" BorderThickness="0,0,0,1">
            <Grid Margin="16,0,10,0">
                <TextBlock x:Name="TitleText" Text="产线楞型-修改" FontSize="13" Foreground="#22303E"
                           FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button Content="✕" FontSize="13" Foreground="#7A8794" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Width="30" Height="28" BorderThickness="0"
                        Background="Transparent" Cursor="Hand" Click="OnCancelClick" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="24,16,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="230" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                    <TextBlock Grid.Column="0" Grid.Row="0" Text="门幅(mm): *" FontSize="11.5" Foreground="#3A4653"
                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,10" />
                    <ComboBox Grid.Column="1" Grid.Row="0" Height="24" FontSize="12" Margin="0,0,14,10"
                              IsEditable="True" ItemsSource="{Binding Options.DoorWidths}"
                              Text="{Binding Row.DoorWidth, UpdateSourceTrigger=LostFocus}" />
                    <TextBlock Grid.Column="2" Grid.Row="0" Text="楞型: *" FontSize="11.5" Foreground="#3A4653"
                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,10" />
                    <ComboBox Grid.Column="3" Grid.Row="0" Height="24" FontSize="12" Margin="0,0,14,10"
                              IsEditable="True" ItemsSource="{Binding Options.FluteTypes}"
                              Text="{Binding Row.FluteType, UpdateSourceTrigger=LostFocus}" />
                    <TextBlock Grid.Column="4" Grid.Row="0" Text="厚度(mm):" FontSize="11.5" Foreground="#3A4653"
                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,10" />
                    <TextBox Grid.Column="5" Grid.Row="0" Height="24" FontSize="12" Margin="0,0,14,10"
                             VerticalContentAlignment="Center" Padding="5,0"
                             Text="{Binding Row.Thickness, UpdateSourceTrigger=LostFocus}" />
                    <TextBlock Grid.Column="0" Grid.Row="1" Text="纸板克重临界值:" FontSize="11.5" Foreground="#3A4653"
                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,10" />
                    <TextBox Grid.Column="1" Grid.Row="1" Height="24" FontSize="12" Margin="0,0,14,10"
                             VerticalContentAlignment="Center" Padding="5,0"
                             Text="{Binding Row.WeightThreshold1, UpdateSourceTrigger=LostFocus}" />
                    <TextBlock Grid.Column="2" Grid.Row="1" Text="厚度1(mm):" FontSize="11.5" Foreground="#3A4653"
                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,10" />
                    <TextBox Grid.Column="3" Grid.Row="1" Height="24" FontSize="12" Margin="0,0,14,10"
                             VerticalContentAlignment="Center" Padding="5,0"
                             Text="{Binding Row.Thickness1, UpdateSourceTrigger=LostFocus}" />
                    <TextBlock Grid.Column="4" Grid.Row="1" Text="纸板克重临界值:" FontSize="11.5" Foreground="#3A4653"
                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,10" />
                    <TextBox Grid.Column="5" Grid.Row="1" Height="24" FontSize="12" Margin="0,0,14,10"
                             VerticalContentAlignment="Center" Padding="5,0"
                             Text="{Binding Row.WeightThreshold2, UpdateSourceTrigger=LostFocus}" />
                    <TextBlock Grid.Column="0" Grid.Row="2" Text="厚度2(mm):" FontSize="11.5" Foreground="#3A4653"
                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,10" />
                    <TextBox Grid.Column="1" Grid.Row="2" Height="24" FontSize="12" Margin="0,0,14,10"
                             VerticalContentAlignment="Center" Padding="5,0"
                             Text="{Binding Row.Thickness2, UpdateSourceTrigger=LostFocus}" />
                    <TextBlock Grid.Column="2" Grid.Row="2" Text="纸板克重临界值:" FontSize="11.5" Foreground="#3A4653"
                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,10" />
                    <TextBox Grid.Column="3" Grid.Row="2" Height="24" FontSize="12" Margin="0,0,14,10"
                             VerticalContentAlignment="Center" Padding="5,0"
                             Text="{Binding Row.WeightThreshold3, UpdateSourceTrigger=LostFocus}" />
                    <TextBlock Grid.Column="4" Grid.Row="2" Text="厚度3(mm):" FontSize="11.5" Foreground="#3A4653"
                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,10" />
                    <TextBox Grid.Column="5" Grid.Row="2" Height="24" FontSize="12" Margin="0,0,14,10"
                             VerticalContentAlignment="Center" Padding="5,0"
                             Text="{Binding Row.Thickness3, UpdateSourceTrigger=LostFocus}" />
                    <TextBlock Grid.Column="0" Grid.Row="3" Text="最大剖数:" FontSize="11.5" Foreground="#3A4653"
                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,10" />
                    <TextBox Grid.Column="1" Grid.Row="3" Height="24" FontSize="12" Margin="0,0,14,10"
                             VerticalContentAlignment="Center" Padding="5,0"
                             Text="{Binding Row.MaxSlit, UpdateSourceTrigger=LostFocus}" />
                    <TextBlock Grid.Column="2" Grid.Row="3" Text="最小切长(mm):" FontSize="11.5" Foreground="#3A4653"
                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,10" />
                    <TextBox Grid.Column="3" Grid.Row="3" Height="24" FontSize="12" Margin="0,0,14,10"
                             VerticalContentAlignment="Center" Padding="5,0"
                             Text="{Binding Row.MinCutLength, UpdateSourceTrigger=LostFocus}" />
                    <TextBlock Grid.Column="4" Grid.Row="3" Text="最大切长(mm):" FontSize="11.5" Foreground="#3A4653"
                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,10" />
                    <TextBox Grid.Column="5" Grid.Row="3" Height="24" FontSize="12" Margin="0,0,14,10"
                             VerticalContentAlignment="Center" Padding="5,0"
                             Text="{Binding Row.MaxCutLength, UpdateSourceTrigger=LostFocus}" />
                    <TextBlock Grid.Column="0" Grid.Row="4" Text="最小修边(mm):" FontSize="11.5" Foreground="#3A4653"
                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,10" />
                    <TextBox Grid.Column="1" Grid.Row="4" Height="24" FontSize="12" Margin="0,0,14,10"
                             VerticalContentAlignment="Center" Padding="5,0"
                             Text="{Binding Row.MinTrim, UpdateSourceTrigger=LostFocus}" />
                    <TextBlock Grid.Column="2" Grid.Row="4" Text="最大修边(mm):" FontSize="11.5" Foreground="#3A4653"
                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,10" />
                    <TextBox Grid.Column="3" Grid.Row="4" Height="24" FontSize="12" Margin="0,0,14,10"
                             VerticalContentAlignment="Center" Padding="5,0"
                             Text="{Binding Row.MaxTrim, UpdateSourceTrigger=LostFocus}" />
                    <TextBlock Grid.Column="4" Grid.Row="4" Text="上堆码限高mm:" FontSize="11.5" Foreground="#3A4653"
                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,10" />
                    <TextBox Grid.Column="5" Grid.Row="4" Height="24" FontSize="12" Margin="0,0,14,10"
                             VerticalContentAlignment="Center" Padding="5,0"
                             Text="{Binding Row.UpperStackLimit, UpdateSourceTrigger=LostFocus}" />
                    <TextBlock Grid.Column="0" Grid.Row="5" Text="下堆码限高mm:" FontSize="11.5" Foreground="#3A4653"
                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,10" />
                    <TextBox Grid.Column="1" Grid.Row="5" Height="24" FontSize="12" Margin="0,0,14,10"
                             VerticalContentAlignment="Center" Padding="5,0"
                             Text="{Binding Row.LowerStackLimit, UpdateSourceTrigger=LostFocus}" />
                    <TextBlock Grid.Column="2" Grid.Row="5" Text="出垛开数临界值:" FontSize="11.5" Foreground="#3A4653"
                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,10" />
                    <TextBox Grid.Column="3" Grid.Row="5" Height="24" FontSize="12" Margin="0,0,14,10"
                             VerticalContentAlignment="Center" Padding="5,0"
                             Text="{Binding Row.StackOpenThreshold1, UpdateSourceTrigger=LostFocus}" />
                    <TextBlock Grid.Column="4" Grid.Row="5" Text="上堆码出垛数:" FontSize="11.5" Foreground="#3A4653"
                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,10" />
                    <TextBox Grid.Column="5" Grid.Row="5" Height="24" FontSize="12" Margin="0,0,14,10"
                             VerticalContentAlignment="Center" Padding="5,0"
                             Text="{Binding Row.UpperStackCount1, UpdateSourceTrigger=LostFocus}" />
                    <TextBlock Grid.Column="0" Grid.Row="6" Text="下堆码出垛数:" FontSize="11.5" Foreground="#3A4653"
                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,10" />
                    <TextBox Grid.Column="1" Grid.Row="6" Height="24" FontSize="12" Margin="0,0,14,10"
                             VerticalContentAlignment="Center" Padding="5,0"
                             Text="{Binding Row.LowerStackCount1, UpdateSourceTrigger=LostFocus}" />
                    <TextBlock Grid.Column="2" Grid.Row="6" Text="出垛开数临界值:" FontSize="11.5" Foreground="#3A4653"
                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,10" />
                    <TextBox Grid.Column="3" Grid.Row="6" Height="24" FontSize="12" Margin="0,0,14,10"
                             VerticalContentAlignment="Center" Padding="5,0"
                             Text="{Binding Row.StackOpenThreshold2, UpdateSourceTrigger=LostFocus}" />
                    <TextBlock Grid.Column="4" Grid.Row="6" Text="上堆码出垛数:" FontSize="11.5" Foreground="#3A4653"
                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,10" />
                    <TextBox Grid.Column="5" Grid.Row="6" Height="24" FontSize="12" Margin="0,0,14,10"
                             VerticalContentAlignment="Center" Padding="5,0"
                             Text="{Binding Row.UpperStackCount2, UpdateSourceTrigger=LostFocus}" />
                    <TextBlock Grid.Column="0" Grid.Row="7" Text="下堆码出垛数:" FontSize="11.5" Foreground="#3A4653"
                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,10" />
                    <TextBox Grid.Column="1" Grid.Row="7" Height="24" FontSize="12" Margin="0,0,14,10"
                             VerticalContentAlignment="Center" Padding="5,0"
                             Text="{Binding Row.LowerStackCount2, UpdateSourceTrigger=LostFocus}" />
                    <TextBlock Grid.Column="2" Grid.Row="7" Text="出垛开数临界值:" FontSize="11.5" Foreground="#3A4653"
                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,10" />
                    <TextBox Grid.Column="3" Grid.Row="7" Height="24" FontSize="12" Margin="0,0,14,10"
                             VerticalContentAlignment="Center" Padding="5,0"
                             Text="{Binding Row.StackOpenThreshold3, UpdateSourceTrigger=LostFocus}" />
                    <TextBlock Grid.Column="4" Grid.Row="7" Text="上堆码出垛数:" FontSize="11.5" Foreground="#3A4653"
                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,10" />
                    <TextBox Grid.Column="5" Grid.Row="7" Height="24" FontSize="12" Margin="0,0,14,10"
                             VerticalContentAlignment="Center" Padding="5,0"
                             Text="{Binding Row.UpperStackCount3, UpdateSourceTrigger=LostFocus}" />
                    <TextBlock Grid.Column="0" Grid.Row="8" Text="下堆码出垛数:" FontSize="11.5" Foreground="#3A4653"
                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,10" />
                    <TextBox Grid.Column="1" Grid.Row="8" Height="24" FontSize="12" Margin="0,0,14,10"
                             VerticalContentAlignment="Center" Padding="5,0"
                             Text="{Binding Row.LowerStackCount3, UpdateSourceTrigger=LostFocus}" />
                    <TextBlock Grid.Column="2" Grid.Row="8" Text="小压线(mm):" FontSize="11.5" Foreground="#3A4653"
                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,10" />
                    <TextBox Grid.Column="3" Grid.Row="8" Height="24" FontSize="12" Margin="0,0,14,10"
                             VerticalContentAlignment="Center" Padding="5,0"
                             Text="{Binding Row.SmallLine, UpdateSourceTrigger=LostFocus}" />
                    <TextBlock Grid.Column="4" Grid.Row="8" Text="小压线加深:" FontSize="11.5" Foreground="#3A4653"
                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,10" />
                    <TextBox Grid.Column="5" Grid.Row="8" Height="24" FontSize="12" Margin="0,0,14,10"
                             VerticalContentAlignment="Center" Padding="5,0"
                             Text="{Binding Row.SmallLineDeepen, UpdateSourceTrigger=LostFocus}" />
                    <TextBlock Grid.Column="0" Grid.Row="9" Text="平压线深度(丝):" FontSize="11.5" Foreground="#3A4653"
                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,10" />
                    <TextBox Grid.Column="1" Grid.Row="9" Height="24" FontSize="12" Margin="0,0,14,10"
                             VerticalContentAlignment="Center" Padding="5,0"
                             Text="{Binding Row.PlainLineDepth, UpdateSourceTrigger=LostFocus}" />
                    <TextBlock Grid.Column="2" Grid.Row="9" Text="普压线深度(丝):" FontSize="11.5" Foreground="#3A4653"
                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,10" />
                    <TextBox Grid.Column="3" Grid.Row="9" Height="24" FontSize="12" Margin="0,0,14,10"
                             VerticalContentAlignment="Center" Padding="5,0"
                             Text="{Binding Row.NormalLineDepth, UpdateSourceTrigger=LostFocus}" />
                    <TextBlock Grid.Column="4" Grid.Row="9" Text="深压线深度(丝):" FontSize="11.5" Foreground="#3A4653"
                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,10" />
                    <TextBox Grid.Column="5" Grid.Row="9" Height="24" FontSize="12" Margin="0,0,14,10"
                             VerticalContentAlignment="Center" Padding="5,0"
                             Text="{Binding Row.DeepLineDepth, UpdateSourceTrigger=LostFocus}" />
                    <TextBlock Grid.Column="0" Grid.Row="10" Text="最大车速(m/min):" FontSize="11.5" Foreground="#3A4653"
                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,10" />
                    <TextBox Grid.Column="1" Grid.Row="10" Height="24" FontSize="12" Margin="0,0,14,10"
                             VerticalContentAlignment="Center" Padding="5,0"
                             Text="{Binding Row.MaxSpeed, UpdateSourceTrigger=LostFocus}" />
                    <TextBlock Grid.Column="2" Grid.Row="10" Text="锟数数量:" FontSize="11.5" Foreground="#3A4653"
                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,10" />
                    <TextBox Grid.Column="3" Grid.Row="10" Height="24" FontSize="12" Margin="0,0,14,10"
                             VerticalContentAlignment="Center" Padding="5,0"
                             Text="{Binding Row.RollerCount, UpdateSourceTrigger=LostFocus}" />
                    <TextBlock Grid.Column="4" Grid.Row="10" Text="修边(mm):" FontSize="11.5" Foreground="#3A4653"
                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,10" />
                    <TextBox Grid.Column="5" Grid.Row="10" Height="24" FontSize="12" Margin="0,0,14,10"
                             VerticalContentAlignment="Center" Padding="5,0"
                             Text="{Binding Row.Trim, UpdateSourceTrigger=LostFocus}" />
                    <TextBlock Grid.Column="0" Grid.Row="11" Text="创建人:" FontSize="11.5" Foreground="#3A4653"
                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,10" />
                    <TextBlock Grid.Column="1" Grid.Row="11" Text="{Binding Creator}" FontSize="11.5" Foreground="#8A95A3"
                               VerticalAlignment="Center" Margin="0,0,14,10" />
                    <TextBlock Grid.Column="2" Grid.Row="11" Text="创建时间:" FontSize="11.5" Foreground="#3A4653"
                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,10" />
                    <TextBlock Grid.Column="3" Grid.Row="11" Text="{Binding CreateTimeText}" FontSize="11.5" Foreground="#8A95A3"
                               VerticalAlignment="Center" Margin="0,0,14,10" />
                    <TextBlock Grid.Column="4" Grid.Row="11" Text="修改人:" FontSize="11.5" Foreground="#3A4653"
                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,10" />
                    <TextBlock Grid.Column="5" Grid.Row="11" Text="{Binding Editor}" FontSize="11.5" Foreground="#8A95A3"
                               VerticalAlignment="Center" Margin="0,0,14,10" />
                    <TextBlock Grid.Column="0" Grid.Row="12" Text="修改时间:" FontSize="11.5" Foreground="#3A4653"
                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,10" />
                    <TextBlock Grid.Column="1" Grid.Row="12" Text="{Binding EditTimeText}" FontSize="11.5" Foreground="#8A95A3"
                               VerticalAlignment="Center" Margin="0,0,14,10" />
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="2" BorderBrush="#E2E7ED" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,20,0">
                <Button Content="取消" Width="90" Height="30" FontSize="12" Click="OnCancelClick" />
                <Button Content="确定" Width="90" Height="30" FontSize="12" Foreground="White" Margin="12,0,0,0"
                        Background="#1A6FD0" BorderThickness="0" Cursor="Hand" Click="OnOkClick" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
