<UserControl x:Class="Corrugator.Client.Wpf.Views.SystemSettingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="SaveButton" TargetType="Button">
            <Setter Property="Height" Value="30" />
            <Setter Property="Width" Value="96" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="#1A6FD0" CornerRadius="3">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#3582D8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1662BB" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#3A4653" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>

        <Style x:Key="FormBox" TargetType="TextBox">
            <Setter Property="Height" Value="28" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>

        <Style x:Key="FormCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="28" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,14" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="120,55,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="自动更新URL：" Style="{StaticResource FormLabel}" />
            <TextBox Grid.Row="0" Grid.Column="1" Width="440" Style="{StaticResource FormBox}"
                     Text="{Binding UpdateUrl, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="生管控制起始页：" Style="{StaticResource FormLabel}" />
            <ComboBox Grid.Row="1" Grid.Column="1" Width="440" Style="{StaticResource FormCombo}"
                      ItemsSource="{Binding StartPageOptions}"
                      SelectedItem="{Binding StartPage, Mode=TwoWay}" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="是否显示任务栏：" Style="{StaticResource FormLabel}" />
            <ComboBox Grid.Row="2" Grid.Column="1" Width="440" Style="{StaticResource FormCombo}"
                      ItemsSource="{Binding TaskbarOptions}"
                      SelectedItem="{Binding TaskbarText, Mode=TwoWay}" />

            <TextBlock Grid.Row="3" Grid.Column="0" Text="语言：" Style="{StaticResource FormLabel}" />
            <ComboBox Grid.Row="3" Grid.Column="1" Width="240" Style="{StaticResource FormCombo}"
                      ItemsSource="{Binding LanguageOptions}"
                      SelectedItem="{Binding Language, Mode=TwoWay}" />

            <CheckBox Grid.Row="4" Grid.Column="1" Content="显示糊机部位选择" FontSize="12" Foreground="#3A4653"
                      Margin="0,4,0,0" IsChecked="{Binding ShowGluePosition, Mode=TwoWay}" />
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="150,0,0,26">
            <Button Content="保存配置" Style="{StaticResource SaveButton}" Click="OnSaveClick" />
            <TextBlock Text="{Binding StatusMessage}" FontSize="11.5" Foreground="#5A6675"
                       VerticalAlignment="Center" Margin="14,0,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
