<Window x:Class="Corrugator.Client.Wpf.Views.UserEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="用户管理-编辑" Width="800" Height="620"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="White">
    <Window.Resources>
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="Height" Value="30" />
            <Setter Property="Width" Value="86" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="#1A6FD0" CornerRadius="2">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#3582D8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DetailLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="#3A4653" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="DetailBox" TargetType="TextBox">
            <Setter Property="Height" Value="26" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Padding" Value="5,2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,3" />
        </Style>

        <Style x:Key="PaneTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#1A6FD0" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </Window.Resources>

    <Border BorderBrush="#C9D2DC" BorderThickness="1" Background="White">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
                <RowDefinition Height="60" />
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border Grid.Row="0" BorderBrush="#E3E8EF" BorderThickness="0,0,0,1">
                <Grid>
                    <TextBlock x:Name="TitleText" Text="用户管理-编辑" FontSize="13" FontWeight="SemiBold"
                               Foreground="#2F3B48" VerticalAlignment="Center" Margin="16,0,0,0" />
                    <Button HorizontalAlignment="Right" Width="40" Height="38" Content="✕" FontSize="15"
                            Foreground="#8A96A3" Background="Transparent" BorderThickness="0" Cursor="Hand"
                            Click="OnCancelClick" />
                </Grid>
            </Border>

            <!-- 三栏正文 -->
            <Grid Grid.Row="1" Margin="16,14,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="262" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="196" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 用户详情 -->
                <Border Grid.Column="0" BorderBrush="#D8DDE4" BorderThickness="1" Padding="10,8">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="用户详情" Style="{StaticResource PaneTitle}" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="账号：*" Style="{StaticResource DetailLabel}" />
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="AccountInput" Style="{StaticResource DetailBox}" MaxLength="50" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="用户名：*" Style="{StaticResource DetailLabel}" />
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="UserNameInput" Style="{StaticResource DetailBox}" MaxLength="50" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="密码：*" Style="{StaticResource DetailLabel}" />
                                <PasswordBox Grid.Row="2" Grid.Column="1" x:Name="PasswordInput" Height="26" FontSize="11.5" Padding="5,2" Margin="0,3" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="性别：" Style="{StaticResource DetailLabel}" />
                                <ComboBox Grid.Row="3" Grid.Column="1" x:Name="GenderInput" Height="26" FontSize="11.5" Margin="0,3" IsEditable="True">
                                    <ComboBoxItem Content="男" />
                                    <ComboBoxItem Content="女" />
                                </ComboBox>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="手机号码：" Style="{StaticResource DetailLabel}" />
                                <TextBox Grid.Row="4" Grid.Column="1" x:Name="PhoneInput" Style="{StaticResource DetailBox}" MaxLength="50" />

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="停机点位：" Style="{StaticResource DetailLabel}" />
                                <ComboBox Grid.Row="5" Grid.Column="1" x:Name="StopPositionInput" Height="26" FontSize="11.5" Margin="0,3" IsEditable="True">
                                    <ComboBoxItem Content="湿部" />
                                    <ComboBoxItem Content="干部" />
                                    <ComboBoxItem Content="全机" />
                                </ComboBox>

                                <TextBlock Grid.Row="6" Grid.Column="0" Text="多端登录：" Style="{StaticResource DetailLabel}" />
                                <CheckBox Grid.Row="6" Grid.Column="1" x:Name="MultiLoginCheck" Margin="0,5,0,5" VerticalAlignment="Center" />

                                <TextBlock Grid.Row="7" Grid.Column="0" Text="是否删除：" Style="{StaticResource DetailLabel}" />
                                <CheckBox Grid.Row="7" Grid.Column="1" x:Name="DeletedCheck" Margin="0,5,0,5" VerticalAlignment="Center" />

                                <TextBlock Grid.Row="8" Grid.Column="0" Text="创建人：" Style="{StaticResource DetailLabel}" />
                                <TextBox Grid.Row="8" Grid.Column="1" x:Name="CreatorInput" Style="{StaticResource DetailBox}" IsReadOnly="True" Background="#F5F7FA" />

                                <TextBlock Grid.Row="9" Grid.Column="0" Text="创建时间：" Style="{StaticResource DetailLabel}" />
                                <TextBox Grid.Row="9" Grid.Column="1" x:Name="CreateTimeInput" Style="{StaticResource DetailBox}" IsReadOnly="True" Background="#F5F7FA" />

                                <TextBlock Grid.Row="10" Grid.Column="0" Text="修改人：" Style="{StaticResource DetailLabel}" />
                                <TextBox Grid.Row="10" Grid.Column="1" x:Name="EditorInput" Style="{StaticResource DetailBox}" IsReadOnly="True" Background="#F5F7FA" />

                                <TextBlock Grid.Row="11" Grid.Column="0" Text="修改时间：" Style="{StaticResource DetailLabel}" />
                                <TextBox Grid.Row="11" Grid.Column="1" x:Name="EditTimeInput" Style="{StaticResource DetailBox}" IsReadOnly="True" Background="#F5F7FA" />
                            </Grid>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- 所属角色 -->
                <Border Grid.Column="2" BorderBrush="#D8DDE4" BorderThickness="1" Padding="10,8">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="所属角色" Style="{StaticResource PaneTitle}" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ListBox x:Name="RoleList" BorderThickness="0" Background="Transparent">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                  FontSize="11.5" Margin="0,4" Checked="OnRoleCheckChanged" Unchecked="OnRoleCheckChanged" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- 可用功能 -->
                <Border Grid.Column="4" BorderBrush="#D8DDE4" BorderThickness="1" Padding="10,8">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="可用功能" Style="{StaticResource PaneTitle}" />
                        <TextBlock DockPanel.Dock="Top" Text="由所选角色的权限合并得到（只读）"
                                   FontSize="10.5" Foreground="#8A96A3" Margin="0,0,0,6" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TreeView x:Name="FunctionTree" BorderThickness="0" Background="Transparent">
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                        <StackPanel Orientation="Horizontal" Margin="0,3">
                                            <CheckBox IsChecked="{Binding IsChecked, Mode=OneWay}"
                                                      IsHitTestVisible="False" Focusable="False"
                                                      VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <TextBlock Text="{Binding Name}" FontSize="11.5" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#5A6675" />
                                                        <Setter Property="FontWeight" Value="Normal" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Type}" Value="菜单">
                                                                <Setter Property="Foreground" Value="#2F3B48" />
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- 底部 -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,16,0">
                <TextBlock x:Name="HintText" FontSize="11" Foreground="#8A96A3" VerticalAlignment="Center" Margin="0,0,14,0" />
                <Button Content="取消" Style="{StaticResource DialogButton}" Click="OnCancelClick" />
                <Button Content="确定" Style="{StaticResource DialogButton}" Margin="10,0,0,0" Click="OnConfirmClick" IsDefault="True" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
