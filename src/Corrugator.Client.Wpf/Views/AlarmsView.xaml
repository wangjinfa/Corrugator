<UserControl x:Class="Corrugator.Client.Wpf.Views.AlarmsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="刷新" Command="{Binding LoadCommand}" />
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
        </StackPanel>

        <DataGrid Grid.Row="1" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedAlarm}"
                  AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="部位代码" Binding="{Binding WA_PartCode}" Width="110" />
                <DataGridTextColumn Header="原因代码" Binding="{Binding WA_ReasonCode}" Width="110" />
                <DataGridTextColumn Header="首次发送" Binding="{Binding WA_FirstSendTime, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="150" />
                <DataGridTextColumn Header="最后一次" Binding="{Binding WA_LastSendTime, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="150" />
                <DataGridTextColumn Header="次数" Binding="{Binding WA_SendNum}" Width="60" />
                <DataGridTextColumn Header="确认人" Binding="{Binding WA_ConfirmBy}" Width="90" />
                <DataGridTextColumn Header="复核说明" Binding="{Binding WA_ReviewNote}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="复核说明" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox Width="320" Text="{Binding ReviewNote, UpdateSourceTrigger=PropertyChanged}" />
                <Button Content="确认选中告警" Command="{Binding ConfirmCommand}" Margin="12,0,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
