<UserControl x:Class="Corrugator.Client.Wpf.Views.ProcessParamsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="6">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,12,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="搜索" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox Width="220" Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}" />
                <Button Content="查询" Command="{Binding LoadCommand}" Margin="12,0,8,0" />
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
            </StackPanel>

            <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="0">
                <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                          AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="参数键" Binding="{Binding Key}" Width="300" />
                        <DataGridTextColumn Header="中文说明" Binding="{Binding Name}" Width="*" />
                        <DataGridTextColumn Header="当前值" Binding="{Binding Value}" Width="110" />
                        <DataGridCheckBoxColumn Header="启用" Binding="{Binding IsOpen}" Width="60" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <Border Grid.Column="1" Style="{StaticResource CardBorder}">
            <StackPanel>
                <TextBlock Text="编辑工艺参数" FontWeight="SemiBold" FontSize="14"
                           Foreground="{StaticResource BrushPrimary}" Margin="0,0,0,10" />

                <TextBlock Text="参数键" Style="{StaticResource CaptionText}" Margin="0,0,0,3" />
                <TextBlock Text="{Binding SelectedItem.Key}" TextWrapping="Wrap" FontSize="12" Foreground="#2C3E50" />

                <TextBlock Text="中文说明" Style="{StaticResource CaptionText}" Margin="0,10,0,3" />
                <TextBlock Text="{Binding SelectedItem.Name}" TextWrapping="Wrap" FontSize="12" Foreground="#2C3E50" />

                <TextBlock Text="新值（数值型填数字，开关型填 true/false）" Style="{StaticResource CaptionText}"
                           TextWrapping="Wrap" Margin="0,14,0,6" />
                <TextBox Text="{Binding EditValue, UpdateSourceTrigger=PropertyChanged}" Height="32" />

                <Button Content="保存" Command="{Binding SaveCommand}" Margin="0,16,0,0" Height="34" />

                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource CaptionText}"
                           TextWrapping="Wrap" Margin="0,12,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
