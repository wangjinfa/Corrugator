<Window x:Class="Corrugator.Client.Wpf.Views.RoleEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="角色管理-编辑" Width="640" Height="560"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="White">
    <Window.Resources>
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="86" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="#1A6FD0" CornerRadius="2">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#3582D8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="#4A5663" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Border BorderBrush="#C9D2DC" BorderThickness="1" Background="White">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="60" />
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E3E8EF" BorderThickness="0,0,0,1">
                <Grid>
                    <TextBlock x:Name="TitleText" Text="角色管理-编辑" FontSize="13" FontWeight="SemiBold"
                               Foreground="#2F3B48" VerticalAlignment="Center" Margin="16,0,0,0" />
                    <Button HorizontalAlignment="Right" Width="40" Height="38" Content="✕" FontSize="15"
                            Foreground="#8A96A3" Background="Transparent" BorderThickness="0" Cursor="Hand"
                            Click="OnCancelClick" />
                </Grid>
            </Border>

            <!-- 角色名称 -->
            <Grid Grid.Row="1" Margin="16,18,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="76" />
                    <ColumnDefinition Width="280" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="角色名称：" Style="{StaticResource FieldLabel}" />
                <TextBox Grid.Column="1" x:Name="NameInput" Height="28" FontSize="12" Padding="6,3" MaxLength="50" />
            </Grid>

            <TextBlock Grid.Row="2" Text="权限绑定" FontSize="11.5" FontWeight="SemiBold" Foreground="#2F3B48"
                       Margin="16,16,16,6" />

            <!-- 权限树 -->
            <Border Grid.Row="3" BorderBrush="#D8DDE4" BorderThickness="1" Margin="16,0,16,0" Background="White">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TreeView x:Name="PermissionTree" Background="Transparent" BorderThickness="0" Padding="10,8">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                    <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding Name}" FontSize="11.5" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#2F3B48" />
                                                <Setter Property="FontWeight" Value="Normal" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Type}" Value="菜单">
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Type}" Value="功能">
                                                        <Setter Property="Foreground" Value="#5A6675" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </ScrollViewer>
            </Border>

            <!-- 底部按钮 -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,16,0">
                <TextBlock x:Name="SummaryText" FontSize="11" Foreground="#8A96A3" VerticalAlignment="Center" Margin="0,0,14,0" />
                <Button Content="取消" Width="86" Height="30" Style="{StaticResource DialogButton}"
                        Background="#1A6FD0" Click="OnCancelClick" />
                <Button Content="确定" Width="86" Height="30" Style="{StaticResource DialogButton}" Margin="10,0,0,0"
                        Click="OnConfirmClick" IsDefault="True" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
