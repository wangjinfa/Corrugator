<UserControl x:Class="Corrugator.Client.Wpf.Views.BasicInfoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- 查询条件区按钮 -->
        <Style x:Key="QueryButton" TargetType="Button">
            <Setter Property="Height" Value="27" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="#1A6FD0" CornerRadius="3">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#3582D8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1662BB" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 表格里的文字链接按钮 -->
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Foreground" Value="#1A6FD0" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="2,1">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 角色表里跟随行选中的链接按钮：选中时变浅色 -->
        <Style x:Key="GridLinkButton" TargetType="Button" BasedOn="{StaticResource LinkButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=IsSelected}" Value="True">
                    <Setter Property="Foreground" Value="#D9E8FF" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 删除链接：平时红字，选中行浅红 -->
        <Style x:Key="GridDeleteLinkButton" TargetType="Button" BasedOn="{StaticResource GridLinkButton}">
            <Setter Property="Foreground" Value="#C0392B" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=IsSelected}" Value="True">
                    <Setter Property="Foreground" Value="#FFB4A8" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============ 左：菜单（基础信息 / 系统设置按模式加载） ============ -->
        <Border Grid.Column="0" Background="#F3F5F8" BorderBrush="#DCE1E7" BorderThickness="0,0,1,0">
            <ListBox x:Name="MenuList" ItemsSource="{Binding Menu}"
                     SelectedItem="{Binding SelectedMenu, Mode=TwoWay}"
                     Background="Transparent" BorderThickness="0" Margin="0,0,0,0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ItemContainerStyle="{StaticResource BasicMenuButton}"
                     SelectionChanged="OnMenuSelectionChanged">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>
        </Border>

        <!-- ============ 右：内容区 ============ -->
        <Grid Grid.Column="1" Background="White">
            <!-- 产线楞型 -->
            <ContentControl x:Name="LineFluteHost" Visibility="{Binding LineFluteVisibility}" />

            <!-- 原纸资料 -->
            <ContentControl x:Name="PaperHost" Visibility="{Binding PaperVisibility}" />

            <!-- 班组资料 -->
            <ContentControl x:Name="TeamHost" Visibility="{Binding TeamVisibility}" />

            <!-- 功能管理 -->
            <Grid Visibility="{Binding PermissionsVisibility}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 查询条件 -->
                <Border Grid.Row="0" BorderBrush="#D8DDE4" BorderThickness="1" Background="White"
                        Margin="12,10,12,0" Padding="10,8">
                    <StackPanel>
                        <TextBlock Text="查询条件" Foreground="#1A6FD0" FontSize="11.5" FontWeight="Bold" Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="菜单名称:" FontSize="11.5" Foreground="#3A4653"
                                       VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox Width="200" Height="26" FontSize="12" Padding="5,2"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding QueryName, UpdateSourceTrigger=PropertyChanged}" />
                            <CheckBox Content="显示全部" FontSize="11.5" VerticalAlignment="Center" Margin="12,0,0,0"
                                      IsChecked="{Binding ShowAll}" />
                            <Button Content="搜索" Style="{StaticResource QueryButton}" Margin="14,0,0,0"
                                    Click="OnPermissionSearch" />
                            <Button Content="重置" Style="{StaticResource QueryButton}" Margin="8,0,0,0"
                                    Click="OnPermissionReset" />
                            <Button Content="＋ 新增菜单功能" Style="{StaticResource QueryButton}" Margin="8,0,0,0"
                                    Click="OnPermissionAdd" />
                            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource CaptionText}"
                                       VerticalAlignment="Center" Margin="12,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 左树 + 右表 -->
                <Grid Grid.Row="1" Margin="12,10,12,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="252" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" BorderBrush="#D8DDE4" BorderThickness="1" Background="White"
                            Margin="0,0,8,0">
                        <TreeView x:Name="PermissionTree" ItemsSource="{Binding MenuTree}"
                                  Background="Transparent" BorderThickness="0" Padding="4"
                                  SelectedItemChanged="OnPermissionNodeChanged">
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal" Background="Transparent" Margin="0,1">
                                        <!-- 功能节点用实心方块区分，菜单节点不显示 -->
                                        <Rectangle Width="6" Height="6" Fill="#3A4653" Margin="0,0,5,0"
                                                   VerticalAlignment="Center">
                                            <Rectangle.Style>
                                                <Style TargetType="Rectangle">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Type}" Value="功能">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Rectangle.Style>
                                        </Rectangle>
                                        <TextBlock Text="{Binding Name}" FontSize="11.5" Foreground="#2F3B48" Padding="0,3">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontWeight" Value="Normal" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Type}" Value="菜单">
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </Border>

                    <Border Grid.Column="1" BorderBrush="#D8DDE4" BorderThickness="1" Background="White">
                        <DataGrid ItemsSource="{Binding Permissions}" AutoGenerateColumns="False" IsReadOnly="True"
                                  BorderThickness="0" HeadersVisibility="Column" CanUserAddRows="False"
                                  GridLinesVisibility="Horizontal" RowHeight="26">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="34">
                                    <DataGridTemplateColumn.Header>
                                        <TextBlock Text="▦" FontSize="12" Foreground="#6B7785" ToolTip="勾选行（批量操作用）" />
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="操作" Width="96">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="修改" Style="{StaticResource LinkButton}" Click="OnPermissionEdit" />
                                                <Button Content="删除" Style="{StaticResource LinkButton}" Foreground="#C0392B"
                                                        Margin="10,0,0,0" Click="OnPermissionDelete" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="名称" Width="170">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Rectangle Width="6" Height="6" Fill="#3A4653" Margin="0,0,5,0"
                                                           VerticalAlignment="Center">
                                                    <Rectangle.Style>
                                                        <Style TargetType="Rectangle">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Type}" Value="功能">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Rectangle.Style>
                                                </Rectangle>
                                                <TextBlock Text="{Binding Name}" FontSize="11.5" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="父节点" Binding="{Binding ParentName}" Width="110" />
                                <DataGridTextColumn Header="类型" Binding="{Binding Type}" Width="64" />
                                <DataGridTextColumn Header="命名空间" Binding="{Binding NameSpace}" Width="110" />
                                <DataGridTextColumn Header="排序号" Binding="{Binding SortNo}" Width="70" />
                                <DataGridTextColumn Header="删除" Binding="{Binding IsDeleted}" Width="56" />
                                <DataGridTextColumn Header="创建人" Binding="{Binding Creator}" Width="80" />
                                <DataGridTextColumn Header="创建时间" Binding="{Binding CreateTime, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="150" />
                                <DataGridTextColumn Header="修改人" Binding="{Binding Editor}" Width="80" />
                                <DataGridTextColumn Header="修改时间" Binding="{Binding EditTime, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="150" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </Grid>

            <!-- 角色管理 -->
            <Grid Visibility="{Binding RolesVisibility}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 查询条件 -->
                <Border Grid.Row="0" BorderBrush="#D8DDE4" BorderThickness="1" Background="White"
                        Margin="12,10,12,0" Padding="10,8">
                    <StackPanel>
                        <TextBlock Text="查询条件" Foreground="#1A6FD0" FontSize="11.5" FontWeight="Bold" Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="角色名称:" FontSize="11.5" Foreground="#3A4653"
                                       VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox Width="200" Height="26" FontSize="12" Padding="5,2"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding RoleQueryName, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Content="搜索" Style="{StaticResource QueryButton}" Margin="14,0,0,0"
                                    Click="OnRoleSearch" />
                            <Button Content="重置" Style="{StaticResource QueryButton}" Margin="8,0,0,0"
                                    Click="OnRoleReset" />
                            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource CaptionText}"
                                       VerticalAlignment="Center" Margin="12,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" BorderBrush="#D8DDE4" BorderThickness="1" Background="White" Margin="12,10,12,10">
                    <DataGrid ItemsSource="{Binding Roles}" AutoGenerateColumns="False" IsReadOnly="True"
                              BorderThickness="0" HeadersVisibility="Column" CanUserAddRows="False"
                              GridLinesVisibility="None" RowHeight="34"
                              RowBackground="White" AlternatingRowBackground="#F7F9FB">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Foreground" Value="#2F3B48" />
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#1A6FD0" />
                                        <Setter Property="Foreground" Value="White" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Padding" Value="6,0" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Foreground" Value="White" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="34">
                                <DataGridTemplateColumn.Header>
                                    <TextBlock Text="▦" FontSize="12" Foreground="#6B7785" ToolTip="勾选行" />
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="操作" Width="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="权限绑定" Style="{StaticResource GridLinkButton}" Click="OnRoleGrant" />
                                            <Button Content="删除" Style="{StaticResource GridDeleteLinkButton}"
                                                    Margin="12,0,0,0" Click="OnRoleDelete" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="角色名称" Binding="{Binding Name}" Width="200" />
                            <DataGridTextColumn Header="创建人" Binding="{Binding Creator}" Width="120" />
                            <DataGridTextColumn Header="创建时间" Binding="{Binding CreateTime, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="180" />
                            <DataGridTextColumn Header="修改人" Binding="{Binding Editor}" Width="120" />
                            <DataGridTextColumn Header="修改时间" Binding="{Binding EditTime, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>

            <!-- 用户管理 -->
            <Grid Visibility="{Binding UsersVisibility}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" BorderBrush="#D8DDE4" BorderThickness="1" Background="White"
                        Margin="12,10,12,0" Padding="10,8">
                    <StackPanel>
                        <TextBlock Text="查询条件" Foreground="#1A6FD0" FontSize="11.5" FontWeight="Bold" Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="用户姓名:" FontSize="11.5" Foreground="#3A4653"
                                       VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox Width="200" Height="26" FontSize="12" Padding="5,2"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding UserQueryName, UpdateSourceTrigger=PropertyChanged}" />
                            <CheckBox Content="显示全部" FontSize="11.5" VerticalAlignment="Center" Margin="12,0,0,0"
                                      IsChecked="{Binding ShowAllUsers}" />
                            <Button Content="搜索" Style="{StaticResource QueryButton}" Margin="14,0,0,0" Click="OnUserSearch" />
                            <Button Content="重置" Style="{StaticResource QueryButton}" Margin="8,0,0,0" Click="OnUserReset" />
                            <Button Content="＋ 新增用户" Style="{StaticResource QueryButton}" Margin="8,0,0,0" Click="OnUserAdd" />
                            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource CaptionText}"
                                       VerticalAlignment="Center" Margin="12,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" BorderBrush="#D8DDE4" BorderThickness="1" Background="White" Margin="12,10,12,10">
                    <DataGrid ItemsSource="{Binding Users}" AutoGenerateColumns="False" IsReadOnly="True"
                              BorderThickness="0" HeadersVisibility="Column" CanUserAddRows="False"
                              GridLinesVisibility="None" RowHeight="34"
                              RowBackground="White" AlternatingRowBackground="#F7F9FB">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Foreground" Value="#2F3B48" />
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#1A6FD0" />
                                        <Setter Property="Foreground" Value="White" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Padding" Value="6,0" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Foreground" Value="White" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="34">
                                <DataGridTemplateColumn.Header>
                                    <TextBlock Text="▦" FontSize="12" Foreground="#6B7785" ToolTip="勾选行" />
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="操作" Width="190">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="修改" Style="{StaticResource GridLinkButton}" Click="OnUserEdit" />
                                            <Button Content="删除" Style="{StaticResource GridDeleteLinkButton}"
                                                    Margin="12,0,0,0" Click="OnUserDelete" />
                                            <Button Content="清理登录缓存" Style="{StaticResource GridLinkButton}"
                                                    Margin="12,0,0,0" Click="OnUserClearCache" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="序号" Binding="{Binding RowNo}" Width="50" />
                            <DataGridTextColumn Header="姓名" Binding="{Binding UserName}" Width="130" />
                            <DataGridTextColumn Header="账号" Binding="{Binding Account}" Width="120" />
                            <DataGridTextColumn Header="手机号码" Binding="{Binding PhoneNo}" Width="120" />
                            <DataGridTextColumn Header="停机点位" Binding="{Binding StopPosition}" Width="90" />
                            <DataGridTextColumn Header="多瓦线" Binding="{Binding IsMultiLine}" Width="66" />
                            <DataGridTextColumn Header="是否删除" Binding="{Binding IsDeleted}" Width="76" />
                            <DataGridTextColumn Header="创建人" Binding="{Binding Creator}" Width="100" />
                            <DataGridTextColumn Header="创建时间" Binding="{Binding CreateTime, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="150" />
                            <DataGridTextColumn Header="修改人" Binding="{Binding Editor}" Width="100" />
                            <DataGridTextColumn Header="修改时间" Binding="{Binding EditTime, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>

            <!-- 通讯设置 -->
            <ContentControl x:Name="CommHost" Visibility="{Binding CommVisibility}" />

            <!-- 系统设置 -->
            <ContentControl x:Name="SystemHost" Visibility="{Binding SystemVisibility}" />

            <!-- API 授权 -->
            <ContentControl x:Name="ApiAuthHost" Visibility="{Binding ApiAuthVisibility}" />

            <!-- 订单颜色设置 -->
            <ContentControl x:Name="OrderColorHost" Visibility="{Binding OrderColorVisibility}" />

            <!-- IPS 部位显示/隐藏 -->
            <ContentControl x:Name="IpsPartHost" Visibility="{Binding IpsPartVisibility}" />

            <!-- 订单扩展字段设置 -->
            <ContentControl x:Name="OrderExtHost" Visibility="{Binding OrderExtVisibility}" />

            <!-- 数据字典（复用现有字典视图） -->
            <ContentControl x:Name="DictionaryHost" Visibility="{Binding DictionaryVisibility}" Margin="8" />

            <!-- 个人信息 -->
            <Border Visibility="{Binding ProfileVisibility}" Margin="16,12">
                <Grid VerticalAlignment="Top">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="个人信息" Style="{StaticResource SectionTitle}" />
                    <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,10,0,0" Padding="18,16" HorizontalAlignment="Left">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="320" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30" />
                                <RowDefinition Height="30" />
                                <RowDefinition Height="30" />
                                <RowDefinition Height="30" />
                                <RowDefinition Height="30" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="登录账号" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding UserAccount}" FontSize="13" VerticalAlignment="Center" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="姓名" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding UserDisplayName}" FontSize="13" VerticalAlignment="Center" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="角色" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding UserRoleText}" FontSize="13" VerticalAlignment="Center" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="瓦线权限" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding UserMultiLineText}" FontSize="13" VerticalAlignment="Center" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="服务端" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ServerText}" FontSize="13" VerticalAlignment="Center" />

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="功能权限" Style="{StaticResource CaptionText}" VerticalAlignment="Top" Margin="0,6,0,0" />
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding UserPermissionText}" FontSize="12.5"
                                       TextWrapping="Wrap" Margin="0,6,0,0" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- 待接入模块的说明 -->
            <StackPanel Visibility="{Binding PlaceholderVisibility}" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="⚙" FontSize="30" Foreground="#C3CBD5" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding PlaceholderText}" FontSize="12.5" Foreground="#8C97A3"
                           TextWrapping="Wrap" TextAlignment="Center" MaxWidth="520" Margin="0,12,0,0" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
