<UserControl x:Class="Corrugator.Client.Wpf.Views.LineFluteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="QBtn" TargetType="Button">
            <Setter Property="Height" Value="27" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="#1A6FD0" CornerRadius="3">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#3582D8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1662BB" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OpLink" TargetType="Button">
            <Setter Property="Foreground" Value="#1A6FD0" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="2,1">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=IsSelected}" Value="True">
                    <Setter Property="Foreground" Value="#D9E8FF" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DelLink" TargetType="Button" BasedOn="{StaticResource OpLink}">
            <Setter Property="Foreground" Value="#C0392B" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=IsSelected}" Value="True">
                    <Setter Property="Foreground" Value="#FFB4A8" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="#F2F4F7">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 查询条件 -->
        <Border Grid.Row="0" Background="White" BorderBrush="#D8DDE4" BorderThickness="1"
                Margin="8,6,8,0" Padding="10,6">
            <StackPanel>
                <TextBlock Text="查询条件" Foreground="#1A6FD0" FontSize="11.5" FontWeight="Bold" Margin="0,0,0,6" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="楞型名称:" FontSize="11.5" Foreground="#3A4653" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox Width="230" Height="26" FontSize="12" Padding="5,2" VerticalContentAlignment="Center"
                             Text="{Binding QueryName, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Content="搜索" Style="{StaticResource QBtn}" Margin="10,0,0,0" Click="OnSearchClick" />
                    <Button Content="重置" Style="{StaticResource QBtn}" Margin="8,0,0,0" Click="OnResetClick" />
                    <Button Content="＋ 新增产线楞型" Style="{StaticResource QBtn}" Margin="8,0,0,0" Click="OnAddClick" />
                    <Button Content="立即更新订单" Style="{StaticResource QBtn}" Margin="8,0,0,0" Click="OnRefreshOrdersClick" />
                    <TextBlock Text="{Binding StatusMessage}" FontSize="11.5" Foreground="#5A6675"
                               VerticalAlignment="Center" Margin="12,0,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 表格 -->
        <Border Grid.Row="1" Background="White" Margin="8,6,8,0" BorderBrush="#E2E7ED" BorderThickness="1">
            <DataGrid x:Name="Grid" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True"
                      BorderThickness="0" HeadersVisibility="Column" CanUserAddRows="False"
                      GridLinesVisibility="None" RowHeight="34" RowBackground="White"
                      AlternatingRowBackground="#F7F9FB"
                      SelectionMode="Single" SelectionUnit="FullRow"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Height" Value="32" />
                        <Setter Property="Background" Value="#F2F4F7" />
                        <Setter Property="Foreground" Value="#4A5663" />
                        <Setter Property="FontSize" Value="11.5" />
                        <Setter Property="FontWeight" Value="Normal" />
                        <Setter Property="BorderBrush" Value="#E2E7ED" />
                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                        <Setter Property="Padding" Value="6,0" />
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Padding" Value="6,0" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="序号" Binding="{Binding RowNo}" Width="50" />
                    <DataGridTemplateColumn Header="操作" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="修改" Style="{StaticResource OpLink}" Click="OnEditRowClick" />
                                    <Button Content="删除" Style="{StaticResource DelLink}" Margin="10,0,0,0" Click="OnDeleteRowClick" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="门幅(mm)" Binding="{Binding DoorWidth}" Width="90" />
                    <DataGridTextColumn Header="楞型" Binding="{Binding FluteType}" Width="80" />
                    <DataGridTextColumn Header="厚度(mm)" Binding="{Binding Thickness}" Width="90" />
                    <DataGridTextColumn Header="厚度1(mm)" Binding="{Binding Thickness1}" Width="90" />
                    <DataGridTextColumn Header="厚度2(mm)" Binding="{Binding Thickness2}" Width="90" />
                    <DataGridTextColumn Header="厚度3(mm)" Binding="{Binding Thickness3}" Width="90" />
                    <DataGridTextColumn Header="克重临界值1" Binding="{Binding WeightThreshold1}" Width="105" />
                    <DataGridTextColumn Header="克重临界值2" Binding="{Binding WeightThreshold2}" Width="105" />
                    <DataGridTextColumn Header="克重临界值3" Binding="{Binding WeightThreshold3}" Width="105" />
                    <DataGridTextColumn Header="最大剖数" Binding="{Binding MaxSlit}" Width="80" />
                    <DataGridTextColumn Header="最小切长(mm)" Binding="{Binding MinCutLength}" Width="105" />
                    <DataGridTextColumn Header="最大切长(mm)" Binding="{Binding MaxCutLength}" Width="105" />
                    <DataGridTextColumn Header="最小修边(mm)" Binding="{Binding MinTrim}" Width="100" />
                    <DataGridTextColumn Header="最大修边(mm)" Binding="{Binding MaxTrim}" Width="100" />
                    <DataGridTextColumn Header="上堆码限高(mm)" Binding="{Binding UpperStackLimit}" Width="110" />
                    <DataGridTextColumn Header="下堆码限高(mm)" Binding="{Binding LowerStackLimit}" Width="110" />
                    <DataGridTextColumn Header="出垛开数临界值" Binding="{Binding StackOpenThreshold1}" Width="110" />
                    <DataGridTextColumn Header="上堆码出垛数" Binding="{Binding UpperStackCount1}" Width="105" />
                    <DataGridTextColumn Header="下堆码出垛数" Binding="{Binding LowerStackCount1}" Width="105" />
                    <DataGridTextColumn Header="小压线(mm)" Binding="{Binding SmallLine}" Width="95" />
                    <DataGridTextColumn Header="小压线加深" Binding="{Binding SmallLineDeepen}" Width="95" />
                    <DataGridTextColumn Header="平压线深度(丝)" Binding="{Binding PlainLineDepth}" Width="115" />
                    <DataGridTextColumn Header="普压线深度(丝)" Binding="{Binding NormalLineDepth}" Width="115" />
                    <DataGridTextColumn Header="深压线深度(丝)" Binding="{Binding DeepLineDepth}" Width="115" />
                    <DataGridTextColumn Header="最大车速(m/min)" Binding="{Binding MaxSpeed}" Width="115" />
                    <DataGridTextColumn Header="锟数数量" Binding="{Binding RollerCount}" Width="80" />
                    <DataGridTextColumn Header="修边(mm)" Binding="{Binding Trim}" Width="*" MinWidth="90" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- 底部规则设置 -->
        <Border Grid.Row="2" Background="#F2F4F7" BorderBrush="#DCE1E7" BorderThickness="0,1,0,0" Padding="10,8">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <CheckBox Content="自动修边规则启用" FontSize="11.5" Foreground="#1A6FD0" VerticalAlignment="Center"
                              IsChecked="{Binding Rule.AutoTrimEnabled}" Click="OnRuleChanged" />
                    <TextBlock Text="当订单修边小于等于" FontSize="11.5" Foreground="#1A6FD0" VerticalAlignment="Center" Margin="14,0,6,0" />
                    <TextBox Width="60" Height="24" FontSize="12" VerticalContentAlignment="Center" Padding="4,0"
                             Text="{Binding Rule.AutoTrimThreshold, UpdateSourceTrigger=LostFocus}" LostFocus="OnRuleChanged" />
                    <TextBlock Text="mm，修边类型自动设置为:" FontSize="11.5" Foreground="#1A6FD0" VerticalAlignment="Center" Margin="6,0,6,0" />
                    <ComboBox Width="130" Height="24" FontSize="12"
                              ItemsSource="{Binding TrimTypes}" SelectedItem="{Binding Rule.AutoTrimType}"
                              SelectionChanged="OnRuleSelectionChanged" />
                    <TextBlock Text="纸板厚度计算压缩率" FontSize="11.5" Foreground="#C00000" VerticalAlignment="Center" Margin="16,0,6,0" />
                    <TextBox Width="60" Height="24" FontSize="12" VerticalContentAlignment="Center" Padding="4,0"
                             Text="{Binding Rule.ThicknessCompressRate, UpdateSourceTrigger=LostFocus}" LostFocus="OnRuleChanged" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="出垛数设置判定依据:" FontSize="11.5" Foreground="#C00000" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox Width="110" Height="24" FontSize="12"
                              ItemsSource="{Binding StackCountBases}" SelectedItem="{Binding Rule.StackCountBasis}"
                              SelectionChanged="OnRuleSelectionChanged" />
                    <TextBlock Text="堆码排垛默认排出方向:" FontSize="11.5" Foreground="#C00000" VerticalAlignment="Center" Margin="18,0,6,0" />
                    <ComboBox Width="110" Height="24" FontSize="12"
                              ItemsSource="{Binding StackDirections}" SelectedItem="{Binding Rule.StackDirection}"
                              SelectionChanged="OnRuleSelectionChanged" />
                    <TextBlock Text="纸板厚度计算模式:" FontSize="11.5" Foreground="#C00000" VerticalAlignment="Center" Margin="18,0,6,0" />
                    <ComboBox Width="140" Height="24" FontSize="12"
                              ItemsSource="{Binding ThicknessCalcModes}" SelectedItem="{Binding Rule.ThicknessCalcMode}"
                              SelectionChanged="OnRuleSelectionChanged" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
