<Window x:Class="Corrugator.Client.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Corrugator.Client.Wpf.Views"
        Title="瓦楞纸板生产线生管系统"
        Height="1000" Width="1600"
        MinHeight="820" MinWidth="1280"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{StaticResource PageBgBrush}">

    <TabControl x:Name="MainTabs" Background="Transparent" BorderThickness="0" Padding="0"
                SelectionChanged="OnTabChanged" ItemContainerStyle="{StaticResource NavTabItem}">
        <TabControl.Template>
            <ControlTemplate TargetType="TabControl">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="64" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- ===== 顶栏 ===== -->
                    <Border Grid.Row="0" Background="{StaticResource NavBgBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Width="46" Height="46" Click="OnOpenSettings"
                                    ToolTip="系统设置" Cursor="Hand" Background="Transparent" BorderThickness="0"
                                    VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="AvatarBg" Width="46" Height="46" CornerRadius="23"
                                                BorderBrush="#46586F" BorderThickness="1" Background="Transparent">
                                            <Path Data="M10 10 m-8.6,0 a8.6,8.6 0 1,0 17.2,0 a8.6,8.6 0 1,0 -17.2,0
                                                        M10 10 m-3.2,0 a3.2,3.2 0 1,0 6.4,0 a3.2,3.2 0 1,0 -6.4,0"
                                                  Stroke="#C9D6E5" StrokeThickness="1.3" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="AvatarBg" Property="Background" Value="#2E86C8" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <TabPanel Grid.Column="1" IsItemsHost="True" HorizontalAlignment="Left"
                                      VerticalAlignment="Stretch" Margin="6,0,0,0" />

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                        Margin="0,0,14,0">
                                <Button Content="复位" Style="{StaticResource GhostButton}" Padding="12,5" Margin="0,0,16,0" />

                                <TextBlock Text="本班：" Foreground="#E8EEF5" FontSize="13" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ShiftName}" Foreground="White" FontSize="14" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Margin="0,0,14,0" />

                                <!-- 瓦线选择：切换后所有请求带 X-Line-Code，后端路由到该线自己的库 -->
                                <ComboBox ItemsSource="{Binding Lines}" SelectedItem="{Binding SelectedLine}"
                                          DisplayMemberPath="Code" Width="104" Height="26" Margin="0,0,18,0"
                                          FontSize="13" VerticalContentAlignment="Center"
                                          Background="White" Foreground="#132136" BorderBrush="#B9C4D1"
                                          ToolTip="{Binding SelectedLine.Name}" />

                                <Ellipse Width="10" Height="10" Fill="#E74C3C" VerticalAlignment="Center" />
                                <TextBlock Text="CCC" Foreground="{StaticResource NavTextBrush}" FontSize="12.5"
                                           VerticalAlignment="Center" Margin="5,0,14,0" />
                                <Ellipse Width="10" Height="10" Fill="#E74C3C" VerticalAlignment="Center" />
                                <TextBlock Text="服务端" Foreground="{StaticResource NavTextBrush}" FontSize="12.5"
                                           VerticalAlignment="Center" Margin="5,0,16,0" />

                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Version}" Foreground="#E8EEF5" FontSize="12"
                                               HorizontalAlignment="Right" />
                                    <TextBlock Text="{Binding UserDisplay}" Foreground="#A9B8C9" FontSize="11"
                                               HorizontalAlignment="Right" />
                                    <TextBlock Text="{Binding NowText}" Foreground="#A9B8C9" FontSize="11"
                                               HorizontalAlignment="Right" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ===== 内容区 ===== -->
                    <Border Grid.Row="1" Background="{StaticResource PageBgBrush}">
                        <Grid>
                            <!-- 当前选中页签内容 -->
                            <ContentPresenter ContentSource="SelectedContent" />

                            <!-- 系统设置（左上角圆环进入，内嵌切换，不弹独立窗口） -->
                            <ContentControl x:Name="SettingsHost" Visibility="Collapsed" Background="White" />
                        </Grid>
                    </Border>
                </Grid>
            </ControlTemplate>
        </TabControl.Template>

        <!-- ① 生管控制 -->
        <TabItem>
            <TabItem.Header>
                <StackPanel>
                    <Path Data="M10 2.6 L11.7 3.8 L13.7 3.5 L14.5 5.3 L16.3 6.1 L16 8.1 L17.2 9.6 L16 11.1 L16.3 13.1 L14.5 13.9 L13.7 15.7 L11.7 15.4 L10 16.6 L8.3 15.4 L6.3 15.7 L5.5 13.9 L3.7 13.1 L4 11.1 L2.8 9.6 L4 8.1 L3.7 6.1 L5.5 5.3 L6.3 3.5 L8.3 3.8 Z M10 7.4 A2.6 2.6 0 1 0 10 12.6 A2.6 2.6 0 1 0 10 7.4 Z"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"
                          StrokeThickness="1.5" Stretch="Uniform" Width="30" Height="30" />
                    <TextBlock Text="生管控制" Foreground="White" FontSize="15" HorizontalAlignment="Center" Margin="0,5,0,0" />
                </StackPanel>
            </TabItem.Header>
            <views:DashboardView DataContext="{Binding Dashboard}" Margin="8" />
        </TabItem>

        <!-- ② 图形化控制 -->
        <TabItem>
            <TabItem.Header>
                <StackPanel>
                    <Path Data="M4 2.5 L16 2.5 L16 17.5 L4 17.5 Z M6.3 13.5 L9 9.8 L11 12.2 L13.7 8.2 L15 13.5 M7 6.3 a1.3 1.3 0 1 0 2.6 0 a1.3 1.3 0 1 0 -2.6 0"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"
                          StrokeThickness="1.5" Stretch="Uniform" Width="30" Height="30" />
                    <TextBlock Text="图形化控制" Foreground="White" FontSize="15" HorizontalAlignment="Center" Margin="0,5,0,0" />
                </StackPanel>
            </TabItem.Header>
            <views:GraphicControlView DataContext="{Binding GraphicControl}" Margin="8" />
        </TabItem>

        <!-- ③ 工单管理 -->
        <TabItem>
            <TabItem.Header>
                <StackPanel>
                    <Path Data="M3.5 4 L16.5 4 L16.5 16 L3.5 16 Z M6 12.5 L8.8 8.5 L11 11.4 L13.2 8.5 L15 12.5"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"
                          StrokeThickness="1.5" Stretch="Uniform" Width="30" Height="30" />
                    <TextBlock Text="工单管理" Foreground="White" FontSize="15" HorizontalAlignment="Center" Margin="0,5,0,0" />
                </StackPanel>
            </TabItem.Header>
            <views:OrdersView DataContext="{Binding Orders}" Margin="8" />
        </TabItem>

        <!-- ④ 预警管理 -->
        <TabItem>
            <TabItem.Header>
                <StackPanel>
                    <Path Data="M10 2.8 A7.2 7.2 0 1 0 10 17.2 A7.2 7.2 0 1 0 10 2.8 Z M7.9 10 L9.5 11.7 L12.4 8.2"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"
                          StrokeThickness="1.5" Stretch="Uniform" Width="30" Height="30" />
                    <TextBlock Text="预警管理" Foreground="White" FontSize="15" HorizontalAlignment="Center" Margin="0,5,0,0" />
                </StackPanel>
            </TabItem.Header>
            <views:AlarmsView DataContext="{Binding Alarms}" Margin="8" />
        </TabItem>

        <!-- ⑤ 报表管理 -->
        <TabItem>
            <TabItem.Header>
                <StackPanel>
                    <Path Data="M2 17.5 L18 17.5 M4 17.5 L4 12 M7.5 17.5 L7.5 7.5 M11 17.5 L11 10 M14.5 17.5 L14.5 5.5"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"
                          StrokeThickness="1.5" Stretch="Uniform" Width="30" Height="30" />
                    <TextBlock Text="报表管理" Foreground="White" FontSize="15" HorizontalAlignment="Center" Margin="0,5,0,0" />
                </StackPanel>
            </TabItem.Header>
            <views:ReportView DataContext="{Binding Report}" Margin="8" />
        </TabItem>

        <!-- ⑥ 基础信息 -->
        <TabItem>
            <TabItem.Header>
                <StackPanel>
                    <Path Data="M4 5 L16 5 M4 10 L16 10 M4 15 L12 15"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"
                          StrokeThickness="1.5" Stretch="Uniform" Width="30" Height="30" />
                    <TextBlock Text="基础信息" Foreground="White" FontSize="15" HorizontalAlignment="Center" Margin="0,5,0,0" />
                </StackPanel>
            </TabItem.Header>
            <views:BasicInfoView DataContext="{Binding BasicInfo}" Margin="0" />
        </TabItem>

        <!-- ⑦ QDM基础表 -->
        <TabItem>
            <TabItem.Header>
                <StackPanel>
                    <Path Data="M4 2.5 L16 2.5 L16 17.5 L4 17.5 Z M6.5 12.5 L8.8 8.5 L11.2 11 L13.8 6.5"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"
                          StrokeThickness="1.5" Stretch="Uniform" Width="30" Height="30" />
                    <TextBlock Text="QDM基础表" Foreground="White" FontSize="15" HorizontalAlignment="Center" Margin="0,5,0,0" />
                </StackPanel>
            </TabItem.Header>
            <views:ProcessParamsView DataContext="{Binding ProcessParams}" Margin="8" />
        </TabItem>
    </TabControl>
</Window>
