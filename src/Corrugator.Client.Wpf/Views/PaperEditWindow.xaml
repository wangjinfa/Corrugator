<Window x:Class="Corrugator.Client.Wpf.Views.PaperEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="原纸资料" Width="470" Height="360" WindowStartupLocation="CenterOwner"
        Background="White" ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="38" />
            <RowDefinition Height="*" />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="#DCE1E7" BorderThickness="0,0,0,1">
            <Grid Margin="14,0,10,0">
                <TextBlock x:Name="TitleText" Text="原纸资料-修改" FontSize="12.5" Foreground="#22303E"
                           FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button Content="✕" FontSize="12" Foreground="#7A8794" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Width="28" Height="26" BorderThickness="0"
                        Background="Transparent" Cursor="Hand" Click="OnCancelClick" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="18,12,18,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="32" />
                <RowDefinition Height="32" />
                <RowDefinition Height="32" />
                <RowDefinition Height="32" />
                <RowDefinition Height="32" />
                <RowDefinition Height="32" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="原纸代号:" FontSize="11.5" Foreground="#3A4653" HorizontalAlignment="Right"
                       VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Grid.Row="0" Grid.Column="1" Height="24" FontSize="12" VerticalContentAlignment="Center"
                     Padding="5,0" Text="{Binding Row.Code, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="1" Text="克重(gsm):" FontSize="11.5" Foreground="#3A4653" HorizontalAlignment="Right"
                       VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Grid.Row="1" Grid.Column="1" Height="24" FontSize="12" VerticalContentAlignment="Center"
                     Padding="5,0" Text="{Binding Row.GramWeight, UpdateSourceTrigger=LostFocus}" />

            <TextBlock Grid.Row="2" Text="门幅(mm):" FontSize="11.5" Foreground="#3A4653" HorizontalAlignment="Right"
                       VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Grid.Row="2" Grid.Column="1" Height="24" FontSize="12" VerticalContentAlignment="Center"
                     Padding="5,0" Text="{Binding Row.PaperWidth, UpdateSourceTrigger=LostFocus}" />

            <TextBlock Grid.Row="3" Text="品牌:" FontSize="11.5" Foreground="#3A4653" HorizontalAlignment="Right"
                       VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Grid.Row="3" Grid.Column="1" Height="24" FontSize="12" VerticalContentAlignment="Center"
                     Padding="5,0" Text="{Binding Row.Brand, UpdateSourceTrigger=LostFocus}" />

            <TextBlock Grid.Row="4" Text="LS2残卷:" FontSize="11.5" Foreground="#3A4653" HorizontalAlignment="Right"
                       VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Grid.Row="4" Grid.Column="1" Height="24" FontSize="12" VerticalContentAlignment="Center"
                     Padding="5,0" Text="{Binding Row.RemainLS2, UpdateSourceTrigger=LostFocus}" />

            <TextBlock Grid.Row="5" Text="MS3残卷:" FontSize="11.5" Foreground="#3A4653" HorizontalAlignment="Right"
                       VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Grid.Row="5" Grid.Column="1" Height="24" FontSize="12" VerticalContentAlignment="Center"
                     Padding="5,0" Text="{Binding Row.RemainMS3, UpdateSourceTrigger=LostFocus}" />

            <TextBlock Grid.Row="6" Text="LS3残卷:" FontSize="11.5" Foreground="#3A4653" HorizontalAlignment="Right"
                       VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Grid.Row="6" Grid.Column="1" Height="24" FontSize="12" VerticalContentAlignment="Center"
                     Padding="5,0" Text="{Binding Row.RemainLS3, UpdateSourceTrigger=LostFocus}" />
        </Grid>

        <Border Grid.Row="2" BorderBrush="#E2E7ED" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0">
                <Button Content="取消" Width="84" Height="28" FontSize="12" Click="OnCancelClick" />
                <Button Content="确定" Width="84" Height="28" FontSize="12" Foreground="White" Margin="10,0,0,0"
                        Background="#1A6FD0" BorderThickness="0" Cursor="Hand" Click="OnOkClick" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
