<UserControl x:Class="Corrugator.Client.Wpf.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="刷新看板" Command="{Binding LoadCommand}" />
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
        </StackPanel>

        <UniformGrid Grid.Row="1" Columns="5" Margin="0,0,0,12">
            <Border Style="{StaticResource CardBorder}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="在制订单" Style="{StaticResource CaptionText}" />
                    <TextBlock Text="{Binding ActiveOrders}" Style="{StaticResource MetricText}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="插单数" Style="{StaticResource CaptionText}" />
                    <TextBlock Text="{Binding UrgentOrders}" Style="{StaticResource MetricText}" Foreground="#C0392B" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="今日完工单数" Style="{StaticResource CaptionText}" />
                    <TextBlock Text="{Binding FinishedToday}" Style="{StaticResource MetricText}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="今日完工米数" Style="{StaticResource CaptionText}" />
                    <TextBlock Text="{Binding FinishedMeterToday, StringFormat={}{0:N0}}" Style="{StaticResource MetricText}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="未确认告警" Style="{StaticResource CaptionText}" />
                    <TextBlock Text="{Binding UnconfirmedAlarms}" Style="{StaticResource MetricText}" Foreground="#D68910" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border Grid.Row="2" Style="{StaticResource CardBorder}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="当前排程（按排序值）" FontWeight="SemiBold"
                           Foreground="{StaticResource BrushPrimary}" Margin="0,0,0,8" />
                <DataGrid ItemsSource="{Binding RecentOrders}" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="工号" Binding="{Binding WO_WorkNo}" Width="70" />
                        <DataGridTextColumn Header="材质" Binding="{Binding WO_PaperCode}" Width="120" />
                        <DataGridTextColumn Header="楞型" Binding="{Binding WO_Wave}" Width="80" />
                        <DataGridTextColumn Header="门幅" Binding="{Binding WO_Width}" Width="90" />
                        <DataGridTextColumn Header="切长" Binding="{Binding WO_CutLength}" Width="90" />
                        <DataGridTextColumn Header="切数" Binding="{Binding WO_CutQty}" Width="80" />
                        <DataGridTextColumn Header="客户" Binding="{Binding WO_CustName}" Width="*" />
                        <DataGridCheckBoxColumn Header="插单" Binding="{Binding WO_IsUrgent}" Width="60" />
                        <DataGridTextColumn Header="预计完成" Binding="{Binding WO_EstFinshTime, StringFormat={}{0:MM-dd HH:mm}}" Width="130" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
