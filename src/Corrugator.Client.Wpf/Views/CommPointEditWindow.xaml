<Window x:Class="Corrugator.Client.Wpf.Views.CommPointEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="通讯点位设置-编辑" Width="770" Height="460"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="White">
    <Window.Resources>
        <Style x:Key="DlgButton" TargetType="Button">
            <Setter Property="Height" Value="30" />
            <Setter Property="Width" Value="88" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="#1A6FD0" CornerRadius="2">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#3582D8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DlgLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#3A4653" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="DlgBox" TargetType="TextBox">
            <Setter Property="Height" Value="26" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="5,2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,5" />
        </Style>
        <Style x:Key="DlgCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="26" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,5" />
        </Style>
    </Window.Resources>

    <Border BorderBrush="#C9D2DC" BorderThickness="1" Background="White">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
                <RowDefinition Height="58" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="#E3E8EF" BorderThickness="0,0,0,1">
                <Grid>
                    <TextBlock x:Name="TitleText" Text="通讯点位设置-编辑" FontSize="13" FontWeight="SemiBold"
                               Foreground="#2F3B48" VerticalAlignment="Center" Margin="16,0,0,0" />
                    <Button HorizontalAlignment="Right" Width="40" Height="38" Content="✕" FontSize="15"
                            Foreground="#8A96A3" Background="Transparent" BorderThickness="0" Cursor="Hand"
                            Click="OnCancelClick" />
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="20,10,20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="118" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="部位：*" Style="{StaticResource DlgLabel}" />
                <ComboBox Grid.Row="0" Grid.Column="1" x:Name="PositionInput" Style="{StaticResource DlgCombo}" IsEditable="True" />

                <TextBlock Grid.Row="0" Grid.Column="3" Text="变量编码：*" Style="{StaticResource DlgLabel}" />
                <ComboBox Grid.Row="0" Grid.Column="4" x:Name="CodeInput" Style="{StaticResource DlgCombo}" IsEditable="True" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="变量名称：*" Style="{StaticResource DlgLabel}" />
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="NameInput" Style="{StaticResource DlgBox}" MaxLength="100" />

                <TextBlock Grid.Row="1" Grid.Column="3" Text="变量说明：*" Style="{StaticResource DlgLabel}" />
                <TextBox Grid.Row="1" Grid.Column="4" x:Name="DescInput" Style="{StaticResource DlgBox}" MaxLength="100" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="所属设备：*" Style="{StaticResource DlgLabel}" />
                <ComboBox Grid.Row="2" Grid.Column="1" x:Name="DeviceInput" Style="{StaticResource DlgCombo}" IsEditable="True" />

                <TextBlock Grid.Row="2" Grid.Column="3" Text="PLC地址/MDI变量名：" Style="{StaticResource DlgLabel}" />
                <TextBox Grid.Row="2" Grid.Column="4" x:Name="AddressInput" Style="{StaticResource DlgBox}" MaxLength="100" />

                <TextBlock Grid.Row="3" Grid.Column="0" Text="数据类型：*" Style="{StaticResource DlgLabel}" />
                <ComboBox Grid.Row="3" Grid.Column="1" x:Name="DataTypeInput" Style="{StaticResource DlgCombo}" IsEditable="True" />

                <TextBlock Grid.Row="3" Grid.Column="3" Text="可读可写：*" Style="{StaticResource DlgLabel}" />
                <ComboBox Grid.Row="3" Grid.Column="4" x:Name="RwInput" Style="{StaticResource DlgCombo}" IsEditable="False" />

                <TextBlock Grid.Row="4" Grid.Column="0" Text="读取间隔：*" Style="{StaticResource DlgLabel}" />
                <TextBox Grid.Row="4" Grid.Column="1" x:Name="IntervalInput" Style="{StaticResource DlgBox}" MaxLength="9" />

                <TextBlock Grid.Row="4" Grid.Column="3" Text="当前值：" Style="{StaticResource DlgLabel}" />
                <TextBox Grid.Row="4" Grid.Column="4" x:Name="CurValueInput" Style="{StaticResource DlgBox}" MaxLength="100" />

                <TextBlock Grid.Row="5" Grid.Column="0" Text="启用：" Style="{StaticResource DlgLabel}" />
                <CheckBox Grid.Row="5" Grid.Column="1" x:Name="UseCheck" Margin="0,8" VerticalAlignment="Center" IsChecked="True" />

                <TextBlock Grid.Row="5" Grid.Column="3" Text="是否删除：" Style="{StaticResource DlgLabel}" />
                <CheckBox Grid.Row="5" Grid.Column="4" x:Name="DeleteCheck" Margin="0,8" VerticalAlignment="Center" />
            </Grid>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,20,0">
                <Button Content="取消" Style="{StaticResource DlgButton}" Click="OnCancelClick" />
                <Button Content="确定" Style="{StaticResource DlgButton}" Margin="10,0,0,0" Click="OnConfirmClick" IsDefault="True" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
