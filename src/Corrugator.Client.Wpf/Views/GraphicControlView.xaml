<UserControl x:Class="Corrugator.Client.Wpf.Views.GraphicControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="640" />
        </Grid.ColumnDefinitions>

        <!-- ================= 左：机台示意图 ================= -->
        <Grid Grid.Column="0" Margin="0,0,8,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ① 湿部 · 单面机 -->
            <Border Grid.Row="0" Style="{StaticResource CardBorder}" Margin="0,0,0,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="{StaticResource AccentBrush}" CornerRadius="2" Padding="9,3">
                                <TextBlock Text="湿部·单面机" Foreground="White" FontSize="11.5" />
                            </Border>
                            <TextBlock Text="原纸架 · 预热缸 · 瓦楞辊 · 天桥" Foreground="{StaticResource MutedBrush}"
                                       FontSize="11.5" VerticalAlignment="Center" Margin="10,0,0,0" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="上弯轻" Foreground="#4A5A6B" FontSize="12" VerticalAlignment="Center" />
                            <Border Width="38" Height="18" CornerRadius="9" Background="#E67E22" Margin="6,0,12,0" />
                            <TextBlock Text="上弯中" Foreground="#4A5A6B" FontSize="12" VerticalAlignment="Center" />
                            <Border Width="38" Height="18" CornerRadius="9" Background="#E7EBF0" BorderBrush="#C9D2DB"
                                    BorderThickness="1" Margin="6,0,12,0" />
                            <TextBlock Text="上弯重" Foreground="#4A5A6B" FontSize="12" VerticalAlignment="Center" />
                            <Border Width="38" Height="18" CornerRadius="9" Background="#E7EBF0" BorderBrush="#C9D2DB"
                                    BorderThickness="1" Margin="6,0,0,0" />
                        </StackPanel>
                    </Grid>

                    <Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="Both" Margin="6,0,6,4">
                        <Canvas Width="1450" Height="260">
                            <!-- 设备底座 -->
                            <Rectangle Canvas.Left="16" Canvas.Top="196" Width="1420" Height="13" Fill="#C6CDD6" />
                            <Rectangle Canvas.Left="16" Canvas.Top="209" Width="1420" Height="8" Fill="#B2BAC4" />

                            <!-- 原纸架 A/B/C -->
                            <Rectangle Canvas.Left="34" Canvas.Top="86" Width="84" Height="104" Fill="#EDF0F4" Stroke="#C2CAD5" />
                            <Ellipse Canvas.Left="43" Canvas.Top="105" Width="66" Height="66" Fill="#D9B677" Stroke="#B08A4C" />
                            <Ellipse Canvas.Left="67" Canvas.Top="129" Width="18" Height="18" Fill="#9AA7B6" />

                            <Rectangle Canvas.Left="124" Canvas.Top="86" Width="84" Height="104" Fill="#EDF0F4" Stroke="#C2CAD5" />
                            <Ellipse Canvas.Left="133" Canvas.Top="105" Width="66" Height="66" Fill="#D9B677" Stroke="#B08A4C" />
                            <Ellipse Canvas.Left="157" Canvas.Top="129" Width="18" Height="18" Fill="#9AA7B6" />

                            <Rectangle Canvas.Left="214" Canvas.Top="70" Width="84" Height="120" Fill="#EDF0F4" Stroke="#C2CAD5" />
                            <Ellipse Canvas.Left="219" Canvas.Top="93" Width="74" Height="74" Fill="#D9B677" Stroke="#B08A4C" />
                            <Ellipse Canvas.Left="246" Canvas.Top="120" Width="20" Height="20" Fill="#9AA7B6" />

                            <!-- 纸幅 -->
                            <Path Data="M256 93 L520 93 L520 132 L690 132" Stroke="#D9B677" StrokeThickness="14" />
                            <Path Data="M166 105 L520 105 L520 158 L690 158" Stroke="#C9A463" StrokeThickness="9" Opacity="0.85" />

                            <!-- 预热缸 -->
                            <Ellipse Canvas.Left="512" Canvas.Top="114" Width="88" Height="88" Fill="#E7EBF0" Stroke="#BFC7D1" />
                            <Ellipse Canvas.Left="526" Canvas.Top="128" Width="60" Height="60" Fill="Transparent"
                                     Stroke="#9AA7B6" StrokeThickness="1" StrokeDashArray="4 6" />

                            <!-- 单面机 -->
                            <Rectangle Canvas.Left="690" Canvas.Top="106" Width="200" Height="118" Fill="#E9EDF2" Stroke="#B7C0CC" />
                            <Ellipse Canvas.Left="708" Canvas.Top="136" Width="60" Height="60" Fill="#DFE4EA" Stroke="#A6B2C0" />
                            <Ellipse Canvas.Left="782" Canvas.Top="136" Width="60" Height="60" Fill="#DFE4EA" Stroke="#A6B2C0" />
                            <Path Data="M768 132 L783 113 L798 132 Z" Fill="#CBD4DE" />

                            <!-- 天桥 -->
                            <Path Data="M890 106 L1120 48 L1120 84 L890 142 Z" Fill="#EAEEF3" Stroke="#B7C0CC" />
                            <Path Data="M904 108 L1108 58" Stroke="#CBD4DE" StrokeThickness="2" />

                            <!-- 送往双面机组 -->
                            <Path Data="M1120 66 L1240 66 L1240 168 L1446 168" Stroke="#D9B677" StrokeThickness="13" />
                            <TextBlock Canvas.Left="1226" Canvas.Top="200" Text="→ 双面机组" FontSize="12" Foreground="#8A97A6" />

                            <!-- 参数块 -->
                            <Border Canvas.Left="88" Canvas.Top="20" Style="{StaticResource ChipBorder}">
                                <TextBlock Text="1.00" Style="{StaticResource ChipText}" />
                            </Border>
                            <Border Canvas.Left="288" Canvas.Top="24" Style="{StaticResource ChipLightBorder}">
                                <TextBlock Text="1.00 1.00" FontSize="11.5" />
                            </Border>
                            <Border Canvas.Left="498" Canvas.Top="182" Style="{StaticResource ChipBorder}">
                                <TextBlock Text="0.95" Style="{StaticResource ChipText}" />
                            </Border>
                            <Border Canvas.Left="638" Canvas.Top="62" Style="{StaticResource ChipBorder}">
                                <TextBlock Text="1.00 1.30" Style="{StaticResource ChipText}" />
                            </Border>
                            <Border Canvas.Left="700" Canvas.Top="16" Style="{StaticResource ChipLightBorder}">
                                <TextBlock Text="{Binding Glue1stText}" FontSize="11.5" />
                            </Border>
                            <Border Canvas.Left="958" Canvas.Top="108" Style="{StaticResource ChipBorder}">
                                <TextBlock Text="1.10" Style="{StaticResource ChipText}" />
                            </Border>
                            <Border Canvas.Left="1132" Canvas.Top="18" Style="{StaticResource ChipBorder}">
                                <TextBlock Text="1.00" Style="{StaticResource ChipText}" />
                            </Border>

                            <TextBlock Canvas.Left="34" Canvas.Top="2" Text="原纸架 A/B/C" FontSize="11" Foreground="#5A6A7B" />
                            <TextBlock Canvas.Left="662" Canvas.Top="228" Text="瓦楞辊间隙" FontSize="11" Foreground="#5A6A7B" />

                            <TextBlock Canvas.Left="1352" Canvas.Top="108" Text="SF1" FontSize="24" FontWeight="Bold" Foreground="#243447" />
                        </Canvas>
                    </Viewbox>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="10,0,10,8">
                        <TextBlock Text="当前工单：" Style="{StaticResource CaptionText}" />
                        <TextBlock Text="{Binding SelectedOrder.WoId}" FontSize="12" Margin="0,0,14,0" />
                        <TextBlock Text="楞型：" Style="{StaticResource CaptionText}" />
                        <TextBlock Text="{Binding SelectedOrder.Wave}" FontSize="12" Margin="0,0,14,0" />
                        <TextBlock Text="门幅：" Style="{StaticResource CaptionText}" />
                        <TextBlock Text="{Binding SelectedOrder.Width}" FontSize="12" Margin="0,0,14,0" />
                        <TextBlock Text="材质：" Style="{StaticResource CaptionText}" />
                        <TextBlock Text="{Binding SelectedOrder.PaperCode}" FontSize="12" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ② 双面机组 -->
            <Border Grid.Row="1" Style="{StaticResource CardBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="{StaticResource AccentBrush}" CornerRadius="2" Padding="9,3">
                                <TextBlock Text="双面机组" Foreground="White" FontSize="11.5" />
                            </Border>
                            <TextBlock Text="糊机 · 热板 · 冷却 · 纵切 · 横切 · 堆码" Foreground="{StaticResource MutedBrush}"
                                       FontSize="11.5" VerticalAlignment="Center" Margin="10,0,0,0" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="下弯轻" Foreground="#4A5A6B" FontSize="12" VerticalAlignment="Center" />
                            <Border Width="38" Height="18" CornerRadius="9" Background="#E7EBF0" BorderBrush="#C9D2DB"
                                    BorderThickness="1" Margin="6,0,12,0" />
                            <TextBlock Text="下弯中" Foreground="#4A5A6B" FontSize="12" VerticalAlignment="Center" />
                            <Border Width="38" Height="18" CornerRadius="9" Background="#E67E22" Margin="6,0,12,0" />
                            <TextBlock Text="下弯重" Foreground="#4A5A6B" FontSize="12" VerticalAlignment="Center" />
                            <Border Width="38" Height="18" CornerRadius="9" Background="#E7EBF0" BorderBrush="#C9D2DB"
                                    BorderThickness="1" Margin="6,0,0,0" />
                        </StackPanel>
                    </Grid>

                    <Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="Both" Margin="6,0,6,4">
                        <Canvas Width="1450" Height="260">
                            <Rectangle Canvas.Left="16" Canvas.Top="196" Width="1420" Height="13" Fill="#C6CDD6" />
                            <Rectangle Canvas.Left="16" Canvas.Top="209" Width="1420" Height="8" Fill="#B2BAC4" />

                            <Path Data="M16 128 L300 128 L300 106 L520 106" Stroke="#D9B677" StrokeThickness="17" />
                            <Ellipse Canvas.Left="524" Canvas.Top="64" Width="84" Height="84" Fill="#E7EBF0" Stroke="#BFC7D1" />
                            <Ellipse Canvas.Left="537" Canvas.Top="77" Width="58" Height="58" Fill="Transparent"
                                     Stroke="#9AA7B6" StrokeThickness="1" StrokeDashArray="4 6" />

                            <!-- 糊机 -->
                            <Rectangle Canvas.Left="650" Canvas.Top="58" Width="160" Height="126" Fill="#E9EDF2" Stroke="#B7C0CC" />
                            <Ellipse Canvas.Left="673" Canvas.Top="101" Width="38" Height="38" Fill="#DFE4EA" Stroke="#A6B2C0" />
                            <Ellipse Canvas.Left="737" Canvas.Top="101" Width="38" Height="38" Fill="#DFE4EA" Stroke="#A6B2C0" />
                            <Rectangle Canvas.Left="682" Canvas.Top="150" Width="96" Height="18" Fill="#2E86C8" Opacity="0.75" />

                            <!-- 热板 -->
                            <Rectangle Canvas.Left="828" Canvas.Top="82" Width="330" Height="98" Fill="#EBEFF4" Stroke="#B7C0CC" />
                            <Line X1="828" Y1="104" X2="1158" Y2="104" Stroke="#9AA7B6" StrokeThickness="1" />
                            <Line X1="828" Y1="127" X2="1158" Y2="127" Stroke="#9AA7B6" StrokeThickness="1" />
                            <Line X1="828" Y1="150" X2="1158" Y2="150" Stroke="#9AA7B6" StrokeThickness="1" />
                            <Path Data="M840 104 L1150 104" Stroke="#D9B677" StrokeThickness="13" />

                            <!-- 冷却 -->
                            <Rectangle Canvas.Left="1176" Canvas.Top="88" Width="112" Height="84" Fill="#F0F4F8" Stroke="#C2CAD5" />
                            <Path Data="M1186 104 L1278 104" Stroke="#D9B677" StrokeThickness="11" />

                            <!-- 纵切 横切 堆码 -->
                            <Rectangle Canvas.Left="1312" Canvas.Top="72" Width="30" Height="112" Fill="#D9E0E8" Stroke="#A6B2C0" />
                            <Rectangle Canvas.Left="1352" Canvas.Top="72" Width="30" Height="112" Fill="#D9E0E8" Stroke="#A6B2C0" />
                            <Rectangle Canvas.Left="1396" Canvas.Top="112" Width="46" Height="72" Fill="#E3E8EE" Stroke="#B7C0CC" />
                            <TextBlock Canvas.Left="1302" Canvas.Top="196" Text="纵切" FontSize="11" Foreground="#8A97A6" />
                            <TextBlock Canvas.Left="1346" Canvas.Top="196" Text="横切" FontSize="11" Foreground="#8A97A6" />
                            <TextBlock Canvas.Left="1388" Canvas.Top="196" Text="堆码" FontSize="11" Foreground="#8A97A6" />

                            <Ellipse Canvas.Left="789" Canvas.Top="190" Width="12" Height="12" Fill="#27AE60" />
                            <Ellipse Canvas.Left="1262" Canvas.Top="64" Width="12" Height="12" Fill="#E67E22" />

                            <!-- 参数块 -->
                            <Border Canvas.Left="212" Canvas.Top="24" Style="{StaticResource ChipBorder}">
                                <TextBlock Text="1.00 1.00" Style="{StaticResource ChipText}" />
                            </Border>
                            <Border Canvas.Left="440" Canvas.Top="14" Style="{StaticResource ChipLightBorder}">
                                <TextBlock Text="{Binding Glue0Text}" FontSize="11.5" />
                            </Border>
                            <Border Canvas.Left="600" Canvas.Top="182" Style="{StaticResource ChipBorder}">
                                <TextBlock Text="1.15" Style="{StaticResource ChipText}" />
                            </Border>
                            <Border Canvas.Left="836" Canvas.Top="18" Style="{StaticResource ChipBorder}">
                                <TextBlock Text="1.00 1.40" Style="{StaticResource ChipText}" />
                            </Border>
                            <Border Canvas.Left="1020" Canvas.Top="182" Style="{StaticResource ChipBorder}">
                                <TextBlock Text="0.00" Style="{StaticResource ChipText}" />
                            </Border>
                            <Border Canvas.Left="1140" Canvas.Top="18" Style="{StaticResource ChipLightBorder}">
                                <TextBlock Text="热板温度 OK" FontSize="11.5" />
                            </Border>
                            <Border Canvas.Left="1290" Canvas.Top="112" Style="{StaticResource ChipBorder}">
                                <TextBlock Text="1.00" Style="{StaticResource ChipText}" />
                            </Border>

                            <TextBlock Canvas.Left="1352" Canvas.Top="108" Text="SF2" FontSize="24" FontWeight="Bold" Foreground="#243447" />
                        </Canvas>
                    </Viewbox>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="10,0,10,8">
                        <TextBlock Text="切长：" Style="{StaticResource CaptionText}" />
                        <TextBlock Text="{Binding SelectedOrder.CutLength}" FontSize="12" Margin="0,0,14,0" />
                        <TextBlock Text="切宽：" Style="{StaticResource CaptionText}" />
                        <TextBlock Text="{Binding SelectedOrder.CutWidth}" FontSize="12" Margin="0,0,14,0" />
                        <TextBlock Text="修边：" Style="{StaticResource CaptionText}" />
                        <TextBlock Text="{Binding SelectedOrder.Trim}" FontSize="12" Margin="0,0,14,0" />
                        <TextBlock Text="排程米数：" Style="{StaticResource CaptionText}" />
                        <TextBlock Text="{Binding SelectedOrder.ScheduleMeter, StringFormat={}{0:N0}}" FontSize="12" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= 右：仪表 + 当前订单备注 ================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="322" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 速度仪表 -->
            <Border Grid.Row="0" Style="{StaticResource CardBorder}" Margin="0,0,0,8">
                <Grid Margin="10,6,10,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="214" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Viewbox Grid.Row="0" Stretch="Uniform">
                        <Canvas Width="640" Height="214">
                            <!-- 表盘弧 + 0-400 刻度 -->
                            <Path Data="M208 126 A112 112 0 0 1 432 126" Stroke="#B4BEC9" StrokeThickness="13" />
                            <Path Data="M208 126 A112 112 0 0 1 240 60" Stroke="#E67E22" StrokeThickness="13" />
                            <Ellipse Canvas.Left="294" Canvas.Top="100" Width="52" Height="52" Fill="White" Stroke="#C6CDD6" />
                            <Line X1="320" Y1="126" X2="262" Y2="158" Stroke="#1E2A38" StrokeThickness="4" />

                            <Line X1="208" Y1="126" X2="220" Y2="126" Stroke="#8D9AA8" StrokeThickness="1.4" />
                            <Line X1="216" Y1="88" X2="226" Y2="94" Stroke="#8D9AA8" StrokeThickness="1.4" />
                            <Line X1="238" Y1="56" X2="245" Y2="65" Stroke="#8D9AA8" StrokeThickness="1.4" />
                            <Line X1="275" Y1="33" X2="279" Y2="43" Stroke="#8D9AA8" StrokeThickness="1.4" />
                            <Line X1="320" Y1="24" X2="320" Y2="35" Stroke="#8D9AA8" StrokeThickness="1.4" />
                            <Line X1="365" Y1="33" X2="361" Y2="43" Stroke="#8D9AA8" StrokeThickness="1.4" />
                            <Line X1="401" Y1="56" X2="394" Y2="65" Stroke="#8D9AA8" StrokeThickness="1.4" />
                            <Line X1="424" Y1="88" X2="414" Y2="94" Stroke="#8D9AA8" StrokeThickness="1.4" />
                            <Line X1="432" Y1="126" X2="420" Y2="126" Stroke="#8D9AA8" StrokeThickness="1.4" />

                            <TextBlock Canvas.Left="182" Canvas.Top="140" Text="0" FontSize="11" Foreground="#8D9AA8" />
                            <TextBlock Canvas.Left="188" Canvas.Top="62" Text="200" FontSize="11" Foreground="#8D9AA8" />
                            <TextBlock Canvas.Left="434" Canvas.Top="62" Text="400" FontSize="11" Foreground="#8D9AA8" />

                            <TextBlock x:Name="GaugeValueText" Canvas.Left="298" Canvas.Top="138"
                                       Text="{Binding GaugeText}" FontSize="26" FontWeight="Bold" Foreground="#1E2A38" />

                            <!-- 趋势网格 -->
                            <Line X1="40" Y1="176" X2="626" Y2="176" Stroke="#E1E6EC" StrokeThickness="1" />
                            <Line X1="40" Y1="192" X2="626" Y2="192" Stroke="#E1E6EC" StrokeThickness="1" />
                            <Line X1="40" Y1="208" X2="626" Y2="208" Stroke="#E1E6EC" StrokeThickness="1" />
                            <Polyline Points="46,206 140,205 240,206 340,205 440,204 540,205 622,204"
                                      Stroke="#9FB0C2" StrokeThickness="1.5" />
                        </Canvas>
                    </Viewbox>

                    <TextBlock Grid.Row="2" Text="m/min" Foreground="#7A8796" FontSize="11"
                               HorizontalAlignment="Right" />
                </Grid>
            </Border>

            <!-- 当前订单备注 + 排程工单 -->
            <Border Grid.Row="1" Style="{StaticResource CardBorder}">
                <Grid Margin="10,6,10,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="当前订单备注：" Style="{StaticResource SectionTitle}" />

                    <!-- 本班 / 本单 指标 -->
                    <Grid Grid.Row="1" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="46" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="1" Text="总长&#10;(m)" Style="{StaticResource CaptionText}" TextAlignment="Right" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="生产&#10;(m)" Style="{StaticResource CaptionText}" TextAlignment="Right" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="0" Grid.Column="3" Text="剩余&#10;(m)" Style="{StaticResource CaptionText}" TextAlignment="Right" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="0" Grid.Column="4" Text="平方&#10;(m²)" Style="{StaticResource CaptionText}" TextAlignment="Right" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="0" Grid.Column="5" Text="均速&#10;(m/min)" Style="{StaticResource CaptionText}" TextAlignment="Right" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="0" Grid.Column="6" Text="不良率&#10;(%)" Style="{StaticResource CaptionText}" TextAlignment="Right" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="0" Grid.Column="7" Text="修边率&#10;(%)" Style="{StaticResource CaptionText}" TextAlignment="Right" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="0" Grid.Column="8" Text="生产&#10;时间" Style="{StaticResource CaptionText}" TextAlignment="Right" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="0" Grid.Column="9" Text="停机&#10;时间" Style="{StaticResource CaptionText}" TextAlignment="Right" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="0" Grid.Column="10" Text="停次" Style="{StaticResource CaptionText}" TextAlignment="Right" TextWrapping="Wrap" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="本班" Style="{StaticResource CaptionText}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ShiftTotal}" FontSize="12.5" TextAlignment="Right" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding ShiftProduced}" FontSize="12.5" TextAlignment="Right" />
                        <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding ShiftRemain}" FontSize="12.5" TextAlignment="Right" />
                        <TextBlock Grid.Row="1" Grid.Column="4" Text="{Binding ShiftSquare}" FontSize="12.5" TextAlignment="Right" />
                        <TextBlock Grid.Row="1" Grid.Column="5" Text="{Binding ShiftAvgSpeed}" FontSize="12.5" TextAlignment="Right" />
                        <TextBlock Grid.Row="1" Grid.Column="6" Text="{Binding ShiftBadRate}" FontSize="12.5" TextAlignment="Right" />
                        <TextBlock Grid.Row="1" Grid.Column="7" Text="{Binding ShiftTrimRate}" FontSize="12.5" TextAlignment="Right" />
                        <TextBlock Grid.Row="1" Grid.Column="8" Text="{Binding ShiftRunTime}" FontSize="12.5" TextAlignment="Right" />
                        <TextBlock Grid.Row="1" Grid.Column="9" Text="{Binding ShiftStopTime}" FontSize="12.5" TextAlignment="Right" />
                        <TextBlock Grid.Row="1" Grid.Column="10" Text="{Binding ShiftStopCount}" FontSize="12.5" TextAlignment="Right" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="本单" Style="{StaticResource CaptionText}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding OrderTotal}" FontSize="12.5" TextAlignment="Right" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding OrderProduced}" FontSize="12.5" TextAlignment="Right" />
                        <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding OrderRemain}" FontSize="12.5" TextAlignment="Right" />
                        <TextBlock Grid.Row="2" Grid.Column="4" Text="{Binding OrderSquare}" FontSize="12.5" TextAlignment="Right" />
                        <TextBlock Grid.Row="2" Grid.Column="5" Text="{Binding OrderAvgSpeed}" FontSize="12.5" TextAlignment="Right" />
                        <TextBlock Grid.Row="2" Grid.Column="6" Text="{Binding OrderBadRate}" FontSize="12.5" TextAlignment="Right" />
                        <TextBlock Grid.Row="2" Grid.Column="7" Text="{Binding OrderTrimRate}" FontSize="12.5" TextAlignment="Right" />
                        <TextBlock Grid.Row="2" Grid.Column="8" Text="{Binding OrderRunTime}" FontSize="12.5" TextAlignment="Right" />
                        <TextBlock Grid.Row="2" Grid.Column="9" Text="{Binding OrderStopTime}" FontSize="12.5" TextAlignment="Right" />
                        <TextBlock Grid.Row="2" Grid.Column="10" Text="{Binding OrderStopCount}" FontSize="12.5" TextAlignment="Right" />
                    </Grid>

                    <!-- 汇总 -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,6,0,4">
                        <TextBlock Text="总计剩余：" Style="{StaticResource CaptionText}" />
                        <TextBlock Text="{Binding TotalRemain}" FontSize="12.5" Foreground="{StaticResource AccentBrush}" Margin="0,0,14,0" />
                        <TextBlock Text="当前剩余：" Style="{StaticResource CaptionText}" />
                        <TextBlock Text="{Binding CurrentRemain}" FontSize="12.5" Foreground="{StaticResource AccentBrush}" Margin="0,0,14,0" />
                        <TextBlock Text="预计时间：" Style="{StaticResource CaptionText}" />
                        <TextBlock Text="{Binding EstimateTime}" FontSize="12.5" Margin="0,0,14,0" />
                        <TextBlock Text="{Binding PageInfo}" FontSize="12.5" Margin="0,0,14,0" />
                        <TextBlock Text="选中订单总长：" Style="{StaticResource CaptionText}" />
                        <TextBlock Text="{Binding SelectedTotal}" FontSize="12.5" Foreground="{StaticResource AccentBrush}" />
                    </StackPanel>

                    <!-- 排程工单（按状态着色） -->
                    <DataGrid Grid.Row="3" ItemsSource="{Binding Orders}" SelectedItem="{Binding SelectedOrder}"
                              AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0"
                              VerticalScrollBarVisibility="Auto">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusIndex}" Value="0">
                                        <Setter Property="Background" Value="{StaticResource RowNavyBrush}" />
                                        <Setter Property="Foreground" Value="White" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StatusIndex}" Value="1">
                                        <Setter Property="Background" Value="{StaticResource RowOrangeBrush}" />
                                        <Setter Property="Foreground" Value="White" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StatusIndex}" Value="2">
                                        <Setter Property="Background" Value="{StaticResource RowYellowBrush}" />
                                        <Setter Property="Foreground" Value="#1E2A38" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="楞型" Binding="{Binding Wave}" Width="60" />
                            <DataGridTextColumn Header="门幅&#10;(mm)" Binding="{Binding Width}" Width="68" />
                            <DataGridTextColumn Header="材质" Binding="{Binding PaperCode}" Width="*" />
                            <DataGridTextColumn Header="客户" Binding="{Binding CustName}" Width="*" />
                            <DataGridTextColumn Header="切长&#10;(mm)" Binding="{Binding CutLength}" Width="66" />
                            <DataGridTextColumn Header="切宽&#10;(mm)" Binding="{Binding CutWidth}" Width="66" />
                            <DataGridTextColumn Header="修边&#10;(mm)" Binding="{Binding Trim}" Width="62" />
                            <DataGridTextColumn Header="排程&#10;米数" Binding="{Binding ScheduleMeter, StringFormat={}{0:N0}}" Width="66" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="4" Text="{Binding StatusMessage}" Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
