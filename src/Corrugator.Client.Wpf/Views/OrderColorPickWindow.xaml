<Window x:Class="Corrugator.Client.Wpf.Views.OrderColorPickWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择颜色" Width="330" Height="250" WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="White" ShowInTaskbar="False">
    <Border BorderBrush="#C9D2DC" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="*" />
                <RowDefinition Height="50" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#F2F5F9" BorderBrush="#DCE3EA" BorderThickness="0,0,0,1">
                <TextBlock Text="选择颜色" FontSize="12.5" Foreground="#2F3B48" VerticalAlignment="Center" Margin="12,0,0,0" />
            </Border>

            <UniformGrid Grid.Row="1" Columns="8" Margin="12,10,12,0" x:Name="Palette" />

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,12,0">
                <Button Content="无颜色" Width="76" Height="28" Click="OnNoneClick" />
                <Button Content="取消" Width="76" Height="28" Margin="8,0,0,0" Click="OnCancelClick" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
