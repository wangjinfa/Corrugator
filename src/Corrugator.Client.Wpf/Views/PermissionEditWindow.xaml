<Window x:Class="Corrugator.Client.Wpf.Views.PermissionEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="菜单功能" Width="420" Height="392"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="White" WindowStyle="SingleBorderWindow">
    <Window.Resources>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="30" />
            <Setter Property="Width" Value="86" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="#1A6FD0" CornerRadius="3">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#3582D8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Background" Value="#A9BDD4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GhostButton2" TargetType="Button">
            <Setter Property="Height" Value="30" />
            <Setter Property="Width" Value="86" />
            <Setter Property="Foreground" Value="#3A4653" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="#EEF1F5" CornerRadius="3" BorderBrush="#D5DCE5" BorderThickness="1">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#E2E7EE" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="#4A5663" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
    </Window.Resources>

    <Grid Margin="18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="TitleText" Text="新增菜单功能" FontSize="13.5" FontWeight="SemiBold"
                   Foreground="#1A6FD0" Margin="0,0,0,12" />

        <StackPanel Grid.Row="1">
            <TextBlock Text="名称" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="NameInput" Height="28" FontSize="12" Padding="6,3" MaxLength="50" />
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock Text="父节点" Style="{StaticResource FieldLabel}" />
            <ComboBox x:Name="ParentCombo" Height="28" FontSize="12" DisplayMemberPath="Name" />
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,10,0,0">
            <TextBlock Text="类型" Style="{StaticResource FieldLabel}" />
            <ComboBox x:Name="TypeCombo" Height="28" FontSize="12">
                <ComboBoxItem Content="功能" IsSelected="True" />
                <ComboBoxItem Content="菜单" />
            </ComboBox>
        </StackPanel>

        <StackPanel Grid.Row="4" Margin="0,10,0,0">
            <TextBlock Text="命名空间" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="NameSpaceInput" Height="28" FontSize="12" Padding="6,3" MaxLength="100" />
        </StackPanel>

        <Grid Grid.Row="5" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="排序号" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="SortInput" Height="28" FontSize="12" Padding="6,3" Text="0" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="备注" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="RemarkInput" Height="28" FontSize="12" Padding="6,3" MaxLength="500" />
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="6" x:Name="ErrorText" Foreground="#D64545" FontSize="11.5" TextWrapping="Wrap" Margin="0,10,0,0" />

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="取消" Style="{StaticResource GhostButton2}" Click="OnCancelClick" IsCancel="True" />
            <Button Content="保存" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" Click="OnSaveClick" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
